---
// One comparison: Zeabur beside another product, in the same ten rows and the same order on
// every page. The other product's case comes before Zeabur's.
import Rich from "../blocks/Rich.astro"
import Icon from "../components/Icon.astro"
import Site from "../layouts/Site.astro"
import { organization } from "../lib/seo.ts"
import { compareUrl, homeUrl, type SiteLocale } from "../lib/urls.ts"
import { breadcrumb } from "./breadcrumb.ts"
import { compareCopy } from "./copy/index.ts"
import Corrections from "./Corrections.astro"
import {
  comparisonSlug,
  competitors,
  criteria,
  published,
  zeabur,
  type CompetitorId,
  type Product,
} from "./data.ts"

interface Props {
  locale: SiteLocale
  id: CompetitorId
}
const { locale, id } = Astro.props
const t = compareCopy[locale]
const page = t.pages[id]!
const them = competitors[id]
const hub = t.hub.heading
const crumbs = [
  { name: "Zeabur", href: homeUrl(locale) },
  { name: hub, href: compareUrl(locale) },
  { name: page.heading, href: compareUrl(locale, comparisonSlug(id)) },
]
const application = (product: Product) => ({
  "@type": "SoftwareApplication",
  name: product.name,
  url: product.url,
  applicationCategory: "DeveloperApplication",
  operatingSystem: product.operatingSystem,
  ...(product.repository ? { sameAs: product.repository } : {}),
})
---

<Site
  locale={locale}
  title={page.title}
  description={page.description}
  schema={{
    "@type": "WebPage",
    name: page.title,
    headline: page.heading,
    description: page.description,
    datePublished: published,
    dateModified: page.checked,
    author: organization,
    publisher: organization,
    about: [application(zeabur), application(them)],
    breadcrumb: breadcrumb(crumbs),
  }}
>
  <article class="wrap compare">
    <header class="compare-head">
      <nav aria-label={hub}>
        <ol class="crumbs">
          {crumbs.slice(0, -1).map((crumb) => (
            <li>
              <a href={crumb.href}>{crumb.name}</a>
            </li>
          ))}
        </ol>
      </nav>
      <h1>{page.heading}</h1>
      <p class="compare-meta">
        {t.lastChecked}
        <time datetime={page.checked}>{page.checked}</time>
        <span aria-hidden="true">·</span>
        {page.versions}
      </p>
      <p class="lead">{page.summary}</p>
      <p class="compare-disclosure">{page.disclosure}</p>
    </header>

    <section aria-labelledby="answer">
      <h2 id="answer">{page.shortAnswer}</h2>
      <div class="choose">
        {[page.chooseThem, page.chooseZeabur].map((choice) => (
          <div>
            <h3>{choice.title}</h3>
            <ul>
              {choice.points.map((point) => (
                <li>
                  <Rich text={point} />
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <section aria-labelledby="table">
      <h2 id="table">{page.table}</h2>
      <p class="compare-note">{t.notDocumented}</p>
      <table class="matrix">
        <thead>
          <tr>
            <th scope="col">{t.criterion}</th>
            <th scope="col">Zeabur</th>
            <th scope="col">{them.name}</th>
            <th scope="col">{t.checked}</th>
          </tr>
        </thead>
        <tbody>
          {criteria.map((criterion) => (
            <tr>
              <th scope="row">{t.criteria[criterion]}</th>
              {(["zeabur", "them"] as const).map((side) => {
                const cell = page.rows[criterion][side]
                return (
                  <td data-label={side === "zeabur" ? "Zeabur" : them.name}>
                    <Rich text={cell.text} />
                    {cell.links.map((link) => (
                      <a href={link.url} class="matrix-source">
                        {link.text}
                        <Icon name="arrow-up-right" />
                      </a>
                    ))}
                  </td>
                )
              })}
              <td data-label={t.checked} class="matrix-day">
                <time datetime={page.checked}>{page.checked}</time>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="compare-note">{page.releases}</p>
    </section>

    <section aria-labelledby="differ">
      <h2 id="differ">{page.differ.title}</h2>
      {page.differ.points.map((point) => (
        <p class="compare-text">
          <Rich text={point} />
        </p>
      ))}
    </section>

    <section aria-labelledby="before">
      <h2 id="before">{t.before.title}</h2>
      <p class="compare-text">{t.before.body}</p>
    </section>

    <section aria-labelledby="soon">
      <h2 id="soon">{t.soon.title}</h2>
      <p class="compare-text">{t.soon.intro}</p>
      <ul class="compare-list">
        {page.soon.map((line) => (
          <li>
            <Rich text={line} />
          </li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="moving">
      <h2 id="moving">{page.moving.title}</h2>
      <p class="compare-text">
        <Rich text={page.moving.body} />
      </p>
      <a href={page.moving.link.url} class="more">
        {page.moving.link.text}
        <Icon name="arrow-right" class="go" />
      </a>
      <p class="compare-text">{page.moving.back}</p>
    </section>

    <Corrections locale={locale} />

    <section aria-labelledby="method">
      <h2 id="method">{t.hub.method.title}</h2>
      <p class="compare-text">{page.method}</p>
      <p class="compare-text compare-small">{page.trademark}</p>
    </section>
  </article>
</Site>
