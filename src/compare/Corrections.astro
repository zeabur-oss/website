---
// How to report a cell that is out of date or wrong.
import Icon from "../components/Icon.astro"
import type { SiteLocale } from "../lib/urls.ts"
import { compareCopy } from "./copy/index.ts"
import { correctionsUrl } from "./data.ts"

interface Props {
  locale: SiteLocale
}
const t = compareCopy[Astro.props.locale].corrections
---

<section aria-labelledby="corrections">
  <h2 id="corrections">{t.title}</h2>
  <p class="compare-text">{t.body}</p>
  <a href={correctionsUrl} class="more">
    {t.link}
    <Icon name="arrow-up-right" class="go" />
  </a>
</section>
