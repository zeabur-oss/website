---
// The three ways to start with Zeabur, on the landing and on the Zeabur page.
import Icon from "../components/Icon.astro"
import { docsUrl, type SiteLocale } from "../lib/urls.ts"
import { landingCopy } from "./copy.ts"

interface Props {
  locale: SiteLocale
}
const { locale } = Astro.props
const start = landingCopy[locale].start
const zeaburDocs = (slug: string) => docsUrl(locale, "zeabur", slug)
const ways = [
  { way: start.server, href: zeaburDocs("get-started/quickstart"), icon: "hard-drives" },
  { way: start.cluster, href: zeaburDocs("get-started/install"), icon: "cube" },
  { way: start.laptop, href: zeaburDocs("reference/zeaburctl"), icon: "laptop" },
]
---

<ul class="grid gap-x-6 md:grid-cols-3">
  {ways.map(({ way, href, icon }, i) => (
    <li data-reveal style={`--i:${i}`}>
      <a
        href={href}
        class="flex flex-col gap-2 border-t border-site-line pt-5 pb-8 text-inherit no-underline transition-[border-color] duration-fast ease-(--ease-site) hover:border-t-site-text"
      >
        <Icon name={icon} class="mb-2 size-5 text-site-accent" />
        <h3>{way.title}</h3>
        <p class="body flex-1">{way.body}</p>
        <span class="more mt-2">
          {way.link}
          <Icon name="arrow-right" class="go" />
        </span>
      </a>
    </li>
  ))}
</ul>
