---
// The three ways to start, ordered by how hands-on the reader wants to be, on the home page and on
// the Zeabur page. Each way names the other two in one line.
import Icon from "../components/Icon.astro"
import { docsUrl, productUrl, type SiteLocale } from "../lib/urls.ts"
import { landingCopy } from "./copy.ts"

interface Props {
  locale: SiteLocale
}
const { locale } = Astro.props
const t = landingCopy[locale].start
const zeaburDocs = (slug: string) => docsUrl(locale, "zeabur", slug)
const ways = [
  {
    id: "start-agent",
    ...t.agent,
    links: [{ href: productUrl(locale, "agent"), text: t.agent.link }],
  },
  {
    id: "start-zeatend",
    ...t.zeatend,
    links: [
      { href: docsUrl(locale, "zeatend"), text: t.zeatend.steps },
      { href: zeaburDocs("install/existing-cluster"), text: t.zeatend.cluster },
    ],
  },
  {
    id: "start-manual",
    ...t.manual,
    links: [
      { href: zeaburDocs("install/one-command"), text: t.manual.server },
      { href: zeaburDocs("install/existing-cluster"), text: t.manual.cluster },
      { href: zeaburDocs("reference/zeaburctl"), text: t.manual.laptop },
    ],
  },
]
---

<ol class="grid border-site-line lg:grid-cols-3 lg:border-l">
  {ways.map((way, i) => (
    <li
      id={way.id}
      class="flex scroll-mt-24 flex-col gap-4 border-t border-site-line py-8 lg:border-r lg:border-b lg:px-6"
      data-reveal
      style={`--i:${i}`}
    >
      <p class="label text-site-accent">{String(i + 1).padStart(2, "0")}</p>
      <h3>{way.title}</h3>
      <p class="body">{way.body}</p>
      <ul class="mt-auto grid border-t border-site-line">
        {way.links.map(({ href, text }) => (
          <li class="border-b border-site-line">
            <a
              href={href}
              class="-mx-2 flex min-h-12 items-center justify-between gap-3 px-2 py-2 font-semibold text-site-text no-underline transition-colors duration-quick hover:bg-site-hover"
            >
              {text}
              <Icon name="arrow-right" class="size-4" />
            </a>
          </li>
        ))}
      </ul>
    </li>
  ))}
</ol>
