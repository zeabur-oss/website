---
import HeadingText from "../components/HeadingText.astro"
import { cn } from "cn"
import Icon from "../components/Icon.astro"
import Site from "../layouts/Site.astro"
import { chrome } from "../lib/chrome.ts"
import { sitePages } from "../lib/site-pages.ts"
import { githubOrg } from "../lib/site.ts"
import { organization } from "../lib/seo.ts"
import { blogUrl, docsUrl, type SiteLocale } from "../lib/urls.ts"
import { landingCopy } from "./copy.ts"
import StartWays from "./StartWays.astro"
import Story from "./Story.astro"
import SectionHead from "./blocks/SectionHead.astro"

interface Props {
  locale: SiteLocale
}
const { locale } = Astro.props
const t = landingCopy[locale]
const c = chrome[locale]
const zeaburDocs = (slug?: string) => docsUrl(locale, "zeabur", slug)

const entrances = [
  { ...t.hero.team, href: zeaburDocs("install/existing-cluster") },
  { ...t.hero.machine, href: zeaburDocs("get-started/quickstart") },
]
const members = (await sitePages(locale)).map((p) => ({
  name: p.name,
  line: p.landingLine,
  href: p.href,
  status: p.tag,
  soon: !p.released,
}))
const number = (i: number) => String(i + 1).padStart(2, "0")
---

<Site
  locale={locale}
  title={t.title}
  description={t.description}
  section="home"
  image={`/og/home/${locale}.png`}
  schema={{
    "@type": "WebSite",
    name: "Zeabur Open Source",
    // The header mark in each locale, so a search in Chinese matches the site name too.
    alternateName: ["Zeabur 開源版", "Zeabur 开源版"],
    description: t.description,
    publisher: organization,
  }}
>
  <section class="wrap hero rails">
    <p class="label text-site-muted" data-reveal>
      {t.hero.meta}
    </p>
    <h1 class="mega mt-6 max-w-[11em]" data-reveal="text">
      <HeadingText text={t.hero.title} />
    </h1>
    <div
      class="mt-10 flex flex-col items-start gap-8 md:mt-14 lg:max-w-[40rem]"
      data-reveal
      style="--i:1"
    >
      <p class="lead">
        <HeadingText text={t.hero.lead} />
      </p>
      <div class="flex flex-wrap gap-3">
        <a href="#start" class="button primary">
          {t.hero.start}
          <Icon name="arrow-down" class="go" />
        </a>
        <a href={`${githubOrg}/zeabur`} class="button">
          <Icon name="github-logo" />
          {t.hero.source}
        </a>
      </div>
    </div>
  </section>

  <Story locale={locale} />

  <div class="wrap band" aria-hidden="true">
    <span class="bg-hatch"></span>
  </div>

  <section class="wrap rails" aria-label={t.hero.start}>
    <ul class="grid md:grid-cols-2">
      {entrances.map((e, i) => (
        <li
          class="border-site-line max-md:not-first:border-t md:not-first:border-l md:first:*:pl-0"
          data-reveal
          style={`--i:${i}`}
        >
          <a
            href={e.href}
            class="group flex h-full flex-col gap-2 px-4 py-8 -mx-4 text-site-text no-underline transition-colors duration-quick hover:bg-site-hover md:mx-0 md:px-8"
          >
            <span class="flex items-center justify-between gap-4 text-2xl font-semibold">
              {e.title}
              <Icon
                name="arrow-right"
                class="size-6 flex-none transition-transform duration-quick group-hover:translate-x-1"
              />
            </span>
            <span class="body opacity-80">{e.body}</span>
            <span class="label mt-2">{e.link}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="wrap section rails" id="start" aria-labelledby="start-title">
    <SectionHead
      id="start-title"
      number="05"
      kicker={t.start.label}
      title={t.start.title}
      lead={t.start.lead}
    />
    <StartWays locale={locale} />
  </section>

  <section class="wrap section rails" id="members" aria-labelledby="members-title">
    <SectionHead
      id="members-title"
      number="06"
      kicker={t.members.label}
      title={t.members.title}
      lead={t.members.lead}
    />
    <ul class="border-b border-site-line">
      {members.map((m, i) => {
        const Row = m.href ? "a" : "div"
        return (
          <li class="border-t border-site-line" data-reveal style={`--i:${i % 4}`}>
            <Row
              href={m.href}
              class={cn(
                "-mx-3 grid grid-cols-[2.5rem_1fr_auto] items-baseline gap-x-4 gap-y-1 px-3 py-5 text-site-text no-underline md:grid-cols-[3rem_minmax(0,18rem)_1fr_auto]",
                m.href && "transition-colors duration-quick hover:bg-site-hover",
              )}
            >
              <span class="label opacity-70">{number(i)}</span>
              <span class="text-lg font-semibold" translate="no">
                {m.name}
              </span>
              <span class="col-start-2 text-sm leading-[1.6] opacity-80 md:col-start-3 md:row-start-1">
                {m.line}
              </span>
              <span class="col-start-3 row-start-1 md:col-start-4">
                {m.soon ? (
                  <span class="soon">{c.nav.soon}</span>
                ) : (
                  <span class="label">{m.status}</span>
                )}
              </span>
            </Row>
          </li>
        )
      })}
    </ul>
    <p class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3" data-reveal>
      <span class="body">{t.members.community}</span>
      <a href={githubOrg} class="more">
        GitHub
        <Icon name="arrow-right" class="go" />
      </a>
      <a href={blogUrl(locale)} class="more">
        {c.nav.blog}
        <Icon name="arrow-right" class="go" />
      </a>
    </p>
  </section>
  <section class="wrap section rails" id="community" aria-labelledby="community-title">
    <a
      href="https://zeabur.com/dc"
      class="on-violet group grid items-center gap-8 rounded-xl bg-(--violet) p-8 text-white no-underline md:grid-cols-[1fr_auto] md:p-12"
      data-reveal
    >
      <span class="flex flex-col gap-4">
        <span class="index label">
          <span>07</span>
          <span>{t.discord.label}</span>
        </span>
        <span id="community-title" class="text-3xl font-semibold md:text-5xl">
          {t.discord.title}
        </span>
        <span class="lead max-w-[36rem]">{t.discord.body}</span>
      </span>
      <span class="button justify-self-start">
        <Icon name="discord-logo" />
        {t.discord.link}
        <Icon
          name="arrow-right"
          class="go transition-transform duration-quick group-hover:translate-x-1"
        />
      </span>
    </a>
  </section>
</Site>
