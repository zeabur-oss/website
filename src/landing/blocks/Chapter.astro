---
// One job on a product page: a kicker, a title and a few lines beside one real screen.
import Icon from "../../components/Icon.astro"
import Shot from "../Shot.astro"
import { sizes } from "../shots.ts"

interface Props {
  id: string
  kicker: string
  title: string
  body: string
  /** Left out when the build has no such shot; the text then stands alone. */
  shot?: { light: string; dark: string; alt: string }
  link?: { href: string; text: string }
}
const { id, kicker, title, body, shot, link } = Astro.props
---

<article class="grid12 split chapter" aria-labelledby={id}>
  <div class="split-text" data-reveal>
    <p class="kicker">{kicker}</p>
    <h3 id={id}>{title}</h3>
    <p class="body">{body}</p>
    {link && (
      <a href={link.href} class="more more-down">
        {link.text}
        <Icon name="arrow-down" class="go" />
      </a>
    )}
  </div>
  {shot && (
    <div class="split-media" data-reveal style="--i:1">
      <Shot {...shot} sizes={sizes.wide} />
    </div>
  )}
</article>
