---
import HeadingText from "../../components/HeadingText.astro"
import { cn } from "cn"
// A section's heading: an optional number and label in mono, the title with an optional quiet
// half, and a lead.
interface Props {
  id: string
  title?: string
  /** The quieter first half of the title. */
  dim?: string
  /** A quieter second half, after a space. */
  tail?: string
  lead?: string
  kicker?: string
  /** The section's place on the page, such as "02". */
  number?: string
  align?: "start" | "center"
}
const { id, title, dim, tail, lead, kicker, number, align = "start" } = Astro.props
// Chinese runs the two halves together; other languages put a space between them.
const gap = dim && !/[　-鿿＀-￯]$/u.test(dim) ? " " : ""
---

<header class={cn("mb-10 max-w-[56rem] md:mb-14", align === "center" && "mx-auto text-center")}>
  {(number || kicker) && (
    <p class="index label mb-6" data-reveal>
      {number && <span>{number}</span>}
      {kicker && <span>{kicker}</span>}
    </p>
  )}
  <h2 id={id} data-reveal="text">
    {tail ? (
      <>
        <HeadingText text={title!} />{" "}
        <span class="text-site-faint zh:inline-block">
          <HeadingText text={tail} />
        </span>
      </>
    ) : dim ? (
      <>
        <span class="text-site-faint zh:inline-block">
          <HeadingText text={dim} />
        </span>
        {gap}
        <span class="zh:inline-block">
          <HeadingText text={title!} />
        </span>
      </>
    ) : (
      title && <HeadingText text={title} />
    )}
  </h2>
  {lead && (
    <p class="lead mt-5" data-reveal style="--i:1">
      <HeadingText text={lead} />
    </p>
  )}
</header>
