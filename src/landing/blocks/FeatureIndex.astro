---
import { cn } from "cn"
// Every feature in groups, one line each, after the Apple and Tailscale feature lists: a name, what
// it does, and what is missing when it is not finished.
import { features, groupNames, featureCopy, type GroupId } from "../features.ts"
import { docsUrl, type SiteLocale } from "../../lib/urls.ts"

interface Props {
  locale: SiteLocale
}
const { locale } = Astro.props
const names = groupNames[locale]
const t = featureCopy[locale]
const groups = Object.keys(names) as GroupId[]
const href = (doc: string) => {
  const [repo, ...rest] = doc.split("/")
  return docsUrl(locale, repo!, rest.join("/") || "index")
}
const featureName = "leading-normal font-semibold text-site-text no-underline"
---

<div>
  {groups.map((group) => {
    const items = features.filter((f) => f.group === group)
    return (
      <section
        class="grid12 scroll-mt-[calc(var(--header-height)+1rem)] gap-y-5 border-t border-site-line py-8 first:border-t-0 first:pt-0"
        id={`features-${group}`}
        aria-labelledby={`features-${group}-title`}
      >
        <h3
          id={`features-${group}-title`}
          class="flex items-baseline gap-2.5 type-heading lg:col-[1/5] lg:flex-col lg:gap-1"
          data-reveal
        >
          {names[group]}
          <span class="type-mono font-normal text-site-faint">{items.length}</span>
        </h3>
        <ul class="grid gap-x-6 gap-y-5 md:grid-cols-2 lg:col-[5/13]">
          {items.map((f) => {
            const [name, line, note] = f[locale]
            return (
              <li class="grid content-start gap-1">
                {f.doc ? (
                  <a class={cn(featureName, "hover:text-site-accent")} href={href(f.doc)}>
                    {name}
                  </a>
                ) : (
                  <span class={featureName}>{name}</span>
                )}
                <span class="body">{line}</span>
                {note && (
                  <span class="type-body text-site-faint before:mr-2 before:inline-block before:size-1.5 before:rounded-full before:border before:border-current before:align-[0.1em] before:content-['']">
                    <span class="sr-only">{t.partial}: </span>
                    {note}
                  </span>
                )}
              </li>
            )
          })}
        </ul>
      </section>
    )
  })}
</div>
