---
import { cn } from "cn"
import Frame from "./Frame.astro"
import type { ShotImage } from "./shots.ts"

interface Props {
  src: ShotImage
  alt: string
  sizes: string
  caption?: string
  eager?: boolean
  class?: string
}
const { src, alt, sizes, caption, eager, class: className } = Astro.props
---

<figure class={cn("shot", className)}>
  <Frame src={src} alt={alt} sizes={sizes} eager={eager} />
  {caption && (
    <figcaption class="mt-3 max-w-[44rem] text-sm leading-[1.6] text-site-muted">
      {caption}
    </figcaption>
  )}
</figure>
