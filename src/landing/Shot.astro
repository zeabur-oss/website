---
import { cn } from "cn"
import type { ShotImage } from "./shots.ts"

interface Props {
  src: ShotImage
  alt: string
  sizes: string
  caption?: string
  eager?: boolean
  class?: string
}
const { src, alt, sizes, caption, eager, class: className } = Astro.props
// Screenshots are taken at twice the pixel density, so their CSS size is half their pixels.
---

<figure class={cn("shot", className)}>
  <div class="overflow-hidden rounded-lg border border-site-line bg-site-bg-soft">
    <img
      class="h-auto w-full align-top"
      src={src.src}
      srcset={`${src.src} ${src.width}w`}
      alt={alt}
      width={src.width / 2}
      height={src.height / 2}
      sizes={sizes}
      decoding="async"
      loading={eager ? "eager" : "lazy"}
    />
  </div>
  {caption && (
    <figcaption class="mt-3 max-w-[44rem] text-sm leading-[1.6] text-site-muted">
      {caption}
    </figcaption>
  )}
</figure>
