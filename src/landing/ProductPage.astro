---
// A product page: the hero, then the sections its row in site-pages.ts lists, numbered in order.
import Site from "../layouts/Site.astro"
import { organization } from "../lib/seo.ts"
import { githubOrg } from "../lib/site.ts"
import { pageRow, pageText, type Section } from "../lib/site-pages.ts"
import type { SiteLocale } from "../lib/urls.ts"
import { chapters } from "./features.ts"
import Chapters from "./sections/Chapters.astro"
import Details from "./sections/Details.astro"
import Features from "./sections/Features.astro"
import Hero from "./sections/Hero.astro"
import Highlights from "./sections/Highlights.astro"
import How from "./sections/How.astro"
import Screens from "./sections/Screens.astro"
import Start from "./sections/Start.astro"
import Steps from "./sections/Steps.astro"

interface Props {
  locale: SiteLocale
  slug: string
}
const { locale, slug } = Astro.props
const row = pageRow(slug)
const text = await pageText(locale, slug)
const components: Record<Section, typeof Highlights> = {
  chapters: Chapters,
  steps: Steps,
  highlights: Highlights,
  how: How,
  features: Features,
  screens: Screens,
  details: Details,
  start: Start,
}
// A story numbers each of its chapters or steps; every other section takes one number.
const size = (s: Section) =>
  s === "chapters" ? chapters.length : s === "steps" ? text.how.steps.length : 1
const sections = row.sections.map((s, i) => ({
  Part: components[s],
  first: row.sections.slice(0, i).reduce((n, before) => n + size(before), 0),
}))
---

<Site
  locale={locale}
  title={text.meta.title}
  description={text.meta.description}
  section="products"
  image={slug === row.repo ? `/og/${slug}.png` : `/og/${slug}/${locale}.png`}
  schema={{
    "@type": "SoftwareApplication",
    name: row.name,
    description: text.meta.description,
    applicationCategory: "DeveloperApplication",
    operatingSystem: row.start.kind === "downloads" ? "macOS, Windows, Linux" : "Linux, Kubernetes",
    license: "https://www.apache.org/licenses/LICENSE-2.0",
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    codeRepository: `${githubOrg}/${row.repo}`,
    publisher: organization,
  }}
>
  <Hero locale={locale} row={row} text={text} />
  {sections.map(({ Part, first }) => (
    <Part locale={locale} row={row} text={text} first={first} />
  ))}
</Site>
