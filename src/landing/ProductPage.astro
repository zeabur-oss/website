---
import { cn } from "cn"
import Icon from "../components/Icon.astro"
import Imagery from "../components/imagery/Imagery.astro"
import Site from "../layouts/Site.astro"
import { productIcon, productName, productVersion, type ProductId } from "../lib/products.ts"
import { githubOrg } from "../lib/site.ts"
import { organization } from "../lib/seo.ts"
import { docsUrl, type SiteLocale } from "../lib/urls.ts"
import { landingCopy } from "./copy.ts"
import { builderExample, catalogExample, identityExample } from "./examples.ts"
import { productCopy } from "./products.ts"
import Shot from "./Shot.astro"
import StartWays from "./StartWays.astro"
import Chapter from "./blocks/Chapter.astro"
import FeatureIndex from "./blocks/FeatureIndex.astro"
import SectionHead from "./blocks/SectionHead.astro"
import { chapters, featureCopy, features, groupNames } from "./features.ts"
import { identityShot, shot, sizes } from "./shots.ts"

interface Props {
  locale: SiteLocale
  id: ProductId
}
const { locale, id } = Astro.props
const t = productCopy[locale][id]
const home = landingCopy[locale]
const name = productName[id]
const repo = `${githubOrg}/${id}`
const docs = {
  zeabur: docsUrl(locale, "zeabur"),
  identity: docsUrl(locale, "identity", "get-started"),
  builder: docsUrl(locale, "builder"),
  catalog: docsUrl(locale, "catalog"),
}[id]

const file = {
  zeabur: undefined,
  identity: identityExample,
  builder: builderExample,
  catalog: catalogExample,
}[id]

const f = featureCopy[locale]
const productShots = productCopy[locale].identity.shots?.captions ?? {}
const known = home.shots as Record<string, string>
const chapterShot = (s: (typeof chapters)[number]["shot"], fallback: string) => {
  if (s.from === "identity") return { src: identityShot(s.id), alt: productShots[s.id] ?? fallback }
  return { src: shot(locale, s.id), alt: known[s.id] ?? fallback }
}
---

<Site
  locale={locale}
  title={t.meta.title}
  description={t.meta.description}
  section="products"
  image={`/og/${id}.png`}
  schema={{
    "@type": "SoftwareApplication",
    name,
    description: t.meta.description,
    applicationCategory: "DeveloperApplication",
    operatingSystem: "Linux, Kubernetes",
    license: "https://www.apache.org/licenses/LICENSE-2.0",
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    codeRepository: repo,
    publisher: organization,
  }}
>
  <section class="wrap hero">
    <div class="grid12">
      <div class="stagger flex flex-col items-start gap-6 lg:col-[1/7] lg:self-center">
        <p class="inline-flex items-center gap-2.5 type-body text-site-muted">
          <span class="mark">
            <Icon name={productIcon[id]} />
          </span>
          {name}
          <span class="pill">{productVersion[id]}</span>
        </p>
        <h1 class="display max-w-[14em] text-[clamp(2.125rem,1.6rem+2.2vw,3.5rem)]">
          <span class="text-site-faint zh:inline-block">{t.titleDim}</span>
          {locale === "en" ? " " : ""}
          <span class="zh:inline-block">{t.title}</span>
        </h1>
        <p class="lead max-w-xl">{t.sub}</p>
        <div class="mt-2 flex flex-wrap gap-3">
          <a href={docs} class="button primary">
            {t.docs}
            <Icon name="arrow-right" class="go" />
          </a>
          <a href={repo} class="button">
            <Icon name="github-logo" />
            {t.source}
          </a>
        </div>
        {id === "zeabur" && (
          <a href="#features" class="more more-down">
            {f.all(features.length)}
            <Icon name="arrow-down" class="go" />
          </a>
        )}
      </div>
      <div class="art lg:col-[7/13]" data-reveal style="--i:2">
        <Imagery id={id} />
      </div>
    </div>
  </section>

  <section class="wrap section" aria-labelledby="highlights">
    <SectionHead id="highlights" dim={t.highlights.titleDim} title={t.highlights.title} />
    <ul class="grid gap-x-6 md:grid-cols-3">
      {t.highlights.items.map((item, i) => (
        <li
          class="flex flex-col gap-2 border-t border-site-line pt-5 pb-8"
          data-reveal
          style={`--i:${i}`}
        >
          <span class="type-mono text-site-faint">{item.tag}</span>
          <h3>{item.title}</h3>
          <p class="body">{item.body}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="wrap section" aria-labelledby="how">
    <SectionHead id="how" dim={t.how.titleDim} title={t.how.title} />
    <ol class="grid gap-x-6 [counter-reset:step] md:grid-cols-3">
      {t.how.steps.map((step, i) => (
        <li
          class="relative flex flex-col gap-2 border-t border-site-line pt-5 pb-8 [counter-increment:step] before:type-mono before:text-site-accent before:content-[counter(step,decimal-leading-zero)]"
          data-reveal
          style={`--i:${i}`}
        >
          <h3>{step.title}</h3>
          <p class="body">{step.body}</p>
        </li>
      ))}
    </ol>
  </section>

  {id === "zeabur" && (
    <section class="wrap section" aria-labelledby="chapters">
      <SectionHead id="chapters" title={f.chapters} />
      {chapters.map((c) => {
        const w = c.words[locale]
        return (
          <Chapter
            id={`chapter-${c.group}`}
            kicker={groupNames[locale][c.group]}
            title={w.title}
            body={w.body}
            shot={chapterShot(c.shot, w.alt)}
            link={{
              href: `#features-${c.group}`,
              text: f.group(features.filter((x) => x.group === c.group).length),
            }}
          />
        )
      })}
    </section>
  )}

  {id === "zeabur" && (
    <section class="wrap section" id="features" aria-labelledby="features-title">
      <SectionHead id="features-title" title={f.index.title} lead={f.index.lead} />
      <FeatureIndex locale={locale} />
    </section>
  )}

  {id === "identity" && t.shots && (
    <section class="wrap section" aria-labelledby="shots">
      <SectionHead id="shots" title={t.shots.title} />
      <div class="grid gap-10 md:grid-cols-2 md:gap-6">
        {["sign-in", "setup"].map((shot, i) => (
          <div data-reveal style={`--i:${i}`}>
            <Shot
              src={identityShot(shot)}
              alt={t.shots!.captions[shot]!}
              caption={t.shots!.captions[shot]}
              sizes={sizes.half}
            />
          </div>
        ))}
      </div>
    </section>
  )}

  <section class="wrap section" aria-labelledby="details">
    <SectionHead id="details" title={t.details.title} />
    <div class="-mx-(--gutter) overflow-x-auto px-(--gutter)" data-reveal>
      <table class="w-full min-w-[36rem] border-collapse text-base">
        <thead>
          <tr>
            {t.details.cols.map((c) => (
              <th
                scope="col"
                class="border-b border-site-line-strong pr-4 pb-3 text-left type-body font-medium text-site-faint"
              >
                {c}
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {t.details.rows.map((row) => (
            <tr>
              {row.map((cell, i) => (
                <td
                  class={cn(
                    "border-b border-site-line py-3.5 pr-4 align-top leading-[1.55] text-site-muted",
                    i === 0 && "text-site-text",
                    i === 0 && (id === "catalog" ? "type-mono" : "font-medium"),
                  )}
                >
                  {cell}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="wrap section" aria-labelledby="start">
    {file ? (
      <div class="grid12">
        <div class="flex flex-col items-start gap-4 lg:col-[1/6]" data-reveal>
          <h2 id="start">{t.start.title}</h2>
          <p class="lead">{t.start.sub}</p>
          <div class="mt-4 flex flex-wrap gap-3">
            <a href={docs} class="button primary">
              {t.start.cta}
              <Icon name="arrow-right" class="go" />
            </a>
          </div>
        </div>
        <pre
          class="min-w-0 self-start overflow-x-auto rounded-lg border border-site-line bg-site-bg-soft px-5 py-4 type-mono leading-[1.65] lg:col-[6/13]"
          data-reveal
          style="--i:1"
        ><code>{file}</code></pre>
      </div>
    ) : (
      <>
        <SectionHead id="start" title={t.start.title} lead={t.start.sub} />
        <StartWays locale={locale} />
      </>
    )}
  </section>
</Site>
