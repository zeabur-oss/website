---
import HeadingText from "../components/HeadingText.astro"
import { cn } from "cn"
import Icon from "../components/Icon.astro"
import Site from "../layouts/Site.astro"
import { desktopRelease } from "../lib/github.ts"
import { githubOrg } from "../lib/site.ts"
import { organization } from "../lib/seo.ts"
import { docsUrl, localeInfo, type SiteLocale } from "../lib/urls.ts"
import { catalogCopy } from "../catalog/copy.ts"
import { browseUrl } from "../catalog/data.ts"
import { landingCopy } from "./copy.ts"
import { builderExample, catalogExample, identityExample, zeatendExample } from "./examples.ts"
import { pageEntry, pageRow } from "../lib/site-pages.ts"
import { chrome } from "../lib/chrome.ts"
import { sectionLabels } from "./products.ts"
import Shot from "./Shot.astro"
import StartWays from "./StartWays.astro"
import ProductStage from "./blocks/ProductStage.astro"
import StoryLayout from "./blocks/StoryLayout.astro"
import FeatureIndex from "./blocks/FeatureIndex.astro"
import SectionHead from "./blocks/SectionHead.astro"
import { chapters, featureCopy, features, groupNames } from "./features.ts"
import { identityShot, shot, sizes } from "./shots.ts"
import { stageOf, type Panel } from "./stages.ts"

interface Props {
  locale: SiteLocale
  slug: string
}
const { locale, slug } = Astro.props
const spec = await pageRow(slug)
const id = spec.repo
const page = await pageEntry(locale, slug)
if (!page) throw new Error(`no page ${locale}/${slug}`)
const t = page.data
const released = t.status === "released"
const chaptered = spec.story === "chapters"
const home = landingCopy[locale]
const name = spec.name
const repo = `${githubOrg}/${id}`
const desktop = slug === "desktop"
const app = await desktopRelease()
// Zeabur's docs can pin a release without Desktop, so its install page is read at Desktop's release.
const docs = desktop
  ? `${githubOrg}/zeabur/blob/${app.tag ?? "main"}/docs/${locale === "en" ? "" : `${locale}/`}install/desktop.mdx`
  : {
      zeabur: docsUrl(locale, "zeabur"),
      identity: docsUrl(locale, "identity", "get-started"),
      builder: docsUrl(locale, "builder"),
      catalog: docsUrl(locale, "catalog"),
      zeatend: docsUrl(locale, "zeatend"),
    }[id]
const download =
  desktop && t.download ? { href: app.page, text: t.download, files: app.files } : undefined

const file = spec.example
  ? {
      identity: identityExample,
      builder: builderExample,
      catalog: catalogExample,
      zeatend: zeatendExample,
    }[id as "identity" | "builder" | "catalog" | "zeatend"]
  : undefined

const f = featureCopy[locale]
const productShots = (await pageEntry(locale, "identity"))?.data.shots?.captions ?? {}
const known = home.shots as Record<string, string>
const chapterShot = (s: (typeof chapters)[number]["shot"], fallback: string) => {
  if (s.from === "identity") {
    return { src: identityShot(s.id, "dark"), alt: productShots[s.id] ?? fallback, whole: true }
  }
  return { src: shot(locale, s.id), alt: known[s.id] ?? fallback, whole: false }
}
const l = sectionLabels[locale]
const number = (i: number) => String(i + 1).padStart(2, "0")
// Chinese runs the two halves of a title together; other languages put a space between them.
const gap = localeInfo(locale).titleGap

// The story: Zeabur walks through its jobs on its own screens, the others through their steps.
const story = chaptered
  ? chapters.map((c) => {
      const w = c.words[locale]
      const s = chapterShot(c.shot, w.alt)
      return {
        kicker: groupNames[locale][c.group],
        title: w.title,
        body: w.body,
        alt: s.alt,
        link: {
          href: `#features-${c.group}`,
          text: f.group(features.filter((x) => x.group === c.group).length),
        },
        panel: {
          title: groupNames[locale][c.group],
          image: s.src,
          alt: s.alt,
          whole: s.whole,
        } as Panel,
      }
    })
  : t.how.steps.map((step) => ({
      kicker: l.how,
      title: step.title,
      body: step.body,
      alt: step.body,
      link: undefined,
      panel: undefined,
    }))
const stage = chaptered
  ? { panels: story.flatMap((c) => (c.panel ? [c.panel] : [])) }
  : stageOf(
      slug,
      locale,
      story.map((c) => c.alt),
      productShots["sign-in"] ?? "",
      app,
    )
const sections = [
  "highlights",
  ...(chaptered ? ["how", "features"] : []),
  ...(t.shots ? ["screens"] : []),
  "details",
  "start",
]
const sectionNumber = (name: string) => number(story.length + sections.indexOf(name))
---

<Site
  locale={locale}
  title={t.meta.title}
  description={t.meta.description}
  section="products"
  image={desktop ? `/og/desktop/${locale}.png` : `/og/${id}.png`}
  schema={{
    "@type": "SoftwareApplication",
    name,
    description: t.meta.description,
    applicationCategory: "DeveloperApplication",
    operatingSystem: desktop ? "macOS, Windows, Linux" : "Linux, Kubernetes",
    license: "https://www.apache.org/licenses/LICENSE-2.0",
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    codeRepository: repo,
    publisher: organization,
  }}
>
  <section class="wrap hero frame">
    <p class="label inline-flex items-center gap-2.5 text-site-muted" data-reveal>
      <Icon name={spec.icon} class="size-4" />
      <span translate="no">{name}</span>
      {released ? (
        spec.tag && <span class="pill">{spec.tag}</span>
      ) : (
        <span class="pill">{chrome[locale].nav.soon}</span>
      )}
      {released && spec.beta && <span class="pill">Beta</span>}
    </p>
    <h1 class="mega mt-6 max-w-[13em]" data-reveal="text">
      <span class="text-site-faint zh:inline-block">
        <HeadingText text={t.titleDim} />
      </span>
      {gap}
      <span class="zh:inline-block">
        <HeadingText text={t.title} />
      </span>
    </h1>
    <div
      class="mt-10 flex flex-col items-start gap-8 md:mt-14 lg:max-w-[40rem]"
      data-reveal
      style="--i:1"
    >
      <p class="lead">
        <HeadingText text={t.sub} />
      </p>
      <div class="flex flex-wrap gap-3">
        {download && (
          <a href={download.href} class="button primary" data-desktop-download>
            <Icon name="download-simple" />
            {download.text}
          </a>
        )}
        <a href={docs} class={download ? "button" : "button primary"}>
          {t.docs}
          <Icon name="arrow-right" class="go" />
        </a>
        {spec.browse && (
          <a href={browseUrl(locale)} class="button">
            <Icon name="squares-four" />
            {catalogCopy[locale].browse}
          </a>
        )}
        <a href={repo} class="button">
          <Icon name="github-logo" />
          {t.source}
        </a>
      </div>
    </div>
  </section>

  <StoryLayout
    id="how-it-works"
    label={chaptered ? f.chapters : `${t.how.titleDim}${gap}${t.how.title}`}
    caption={story.map((c) => c.alt).join(" ")}
  >
    <SectionHead
      slot="head"
      id="story-title"
      dim={chaptered ? undefined : t.how.titleDim}
      title={chaptered ? f.chapters : t.how.title}
    />
    <ProductStage slot="stage" {...stage} />
    {story.map((c, i) => (
      <li data-chapter={i} id={chaptered ? `chapter-${chapters[i]!.group}` : undefined}>
        <p class="index label">
          <span>{number(i)}</span>
          <span>{c.kicker}</span>
        </p>
        <h2>
          <HeadingText text={c.title} />
        </h2>
        <p class="lead">
          <HeadingText text={c.body} />
        </p>
        {c.link && (
          <a href={c.link.href} class="more more-down mt-2">
            {c.link.text}
            <Icon name="arrow-down" class="go" />
          </a>
        )}
      </li>
    ))}
  </StoryLayout>

  <div class="wrap band" aria-hidden="true">
    <span class="bg-hatch"></span>
  </div>

  <section class="wrap section frame" aria-labelledby="highlights">
    <SectionHead
      id="highlights"
      number={sectionNumber("highlights")}
      kicker={l.highlights}
      dim={t.highlights.titleDim}
      title={t.highlights.title}
    />
    <ul class="grid gap-x-6 md:grid-cols-3">
      {t.highlights.items.map((item, i) => (
        <li
          class="flex flex-col gap-2 border-t border-site-line pt-5 pb-8"
          data-reveal
          style={`--i:${i}`}
        >
          <span class="type-mono text-site-faint">{item.tag}</span>
          <h3>
            <HeadingText text={item.title} />
          </h3>
          <p class="body">{item.body}</p>
        </li>
      ))}
    </ul>
  </section>

  {chaptered && (
    <section class="wrap section frame" aria-labelledby="how">
      <SectionHead
        id="how"
        number={sectionNumber("how")}
        kicker={l.how}
        dim={t.how.titleDim}
        title={t.how.title}
      />
      <ol class="grid gap-x-6 md:grid-cols-3">
        {t.how.steps.map((step, i) => (
          <li
            class="flex flex-col gap-2 border-t border-site-line pt-5 pb-8"
            data-reveal
            style={`--i:${i}`}
          >
            <span class="type-mono text-site-accent">{number(i)}</span>
            <h3>
              <HeadingText text={step.title} />
            </h3>
            <p class="body">{step.body}</p>
          </li>
        ))}
      </ol>
    </section>
  )}

  {chaptered && (
    <section class="wrap section frame" id="features" aria-labelledby="features-title">
      <SectionHead
        id="features-title"
        number={sectionNumber("features")}
        kicker={l.features}
        title={f.index.title}
        lead={f.index.lead}
      />
      <FeatureIndex locale={locale} />
    </section>
  )}

  {t.shots && (
    <section class="wrap section frame" aria-labelledby="shots">
      <SectionHead
        id="shots"
        number={sectionNumber("screens")}
        kicker={l.screens}
        title={t.shots.title}
      />
      <div class="grid gap-10 md:grid-cols-2 md:gap-6">
        {["sign-in", "setup"].map((shot, i) => (
          <div data-reveal style={`--i:${i}`}>
            <Shot
              src={identityShot(shot)}
              alt={t.shots!.captions[shot]!}
              caption={t.shots!.captions[shot]}
              sizes={sizes.half}
            />
          </div>
        ))}
      </div>
    </section>
  )}

  <section class="wrap section frame" aria-labelledby="details">
    <SectionHead
      id="details"
      number={sectionNumber("details")}
      kicker={l.details}
      title={t.details.title}
    />
    <div class="-mx-(--gutter) overflow-x-auto px-(--gutter)" data-reveal>
      <table class="w-full min-w-[36rem] border-collapse text-base">
        <thead>
          <tr>
            {t.details.cols.map((c) => (
              <th
                scope="col"
                class="border-b border-site-line-strong pr-4 pb-3 text-left type-body font-medium text-site-faint"
              >
                {c}
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {t.details.rows.map((row) => (
            <tr>
              {row.map((cell, i) => (
                <td
                  class={cn(
                    "border-b border-site-line py-3.5 pr-4 align-top leading-[1.55] text-site-muted",
                    i === 0 && "text-site-text",
                    i === 0 && (spec.monoNames ? "type-mono" : "font-medium"),
                  )}
                >
                  {cell}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="wrap section frame" aria-labelledby="start">
    {file ? (
      <div class="grid12">
        <div class="flex flex-col items-start gap-4 lg:col-[1/6]" data-reveal>
          <p class="index label">
            <span>{sectionNumber("start")}</span>
            <span>{l.start}</span>
          </p>
          <h2 id="start">
            <HeadingText text={t.start.title} />
          </h2>
          <p class="lead">
            <HeadingText text={t.start.sub} />
          </p>
          <div class="mt-4 flex flex-wrap gap-3">
            <a href={docs} class="button primary">
              {t.start.cta}
              <Icon name="arrow-right" class="go" />
            </a>
          </div>
        </div>
        <pre
          class="min-w-0 self-start overflow-x-auto rounded-lg border border-site-line bg-site-bg-soft px-5 py-4 type-mono leading-[1.65] lg:col-[6/13]"
          data-reveal
          style="--i:1"
        ><code>{file}</code></pre>
      </div>
    ) : (
      <>
        <SectionHead
          id="start"
          number={sectionNumber("start")}
          kicker={l.start}
          title={t.start.title}
          lead={t.start.sub}
        />
        {download ? (
          <div class="grid gap-8" data-reveal>
            <div class="grid gap-3">
              <div class="flex flex-wrap gap-3">
                <a href={download.href} class="button primary" data-desktop-download>
                  <Icon name="download-simple" />
                  {t.start.cta}
                </a>
                <a href={docs} class="button">
                  {t.docs}
                  <Icon name="arrow-right" class="go" />
                </a>
              </div>
              <p class="type-mono text-sm text-site-muted" data-desktop-file hidden />
            </div>
            <ul class="grid max-w-3xl border-t border-site-line">
              {download.files.map((f) => (
                <li class="border-b border-site-line">
                  <a
                    href={f.url}
                    class="-mx-2 flex min-h-12 items-center justify-between gap-3 px-2 py-2 text-site-text no-underline transition-colors duration-quick hover:bg-site-hover type-mono text-sm"
                  >
                    <span class="min-w-0 break-all">{f.name}</span>
                    <Icon name="download-simple" class="size-4 shrink-0" />
                  </a>
                </li>
              ))}
              {t.releasePage && (
                <li class="border-b border-site-line">
                  <a
                    href={download.href}
                    class="-mx-2 flex min-h-12 items-center justify-between gap-3 px-2 py-2 text-site-text no-underline transition-colors duration-quick hover:bg-site-hover font-semibold"
                  >
                    {t.releasePage}
                    <Icon name="arrow-up-right" class="size-4 shrink-0" />
                  </a>
                </li>
              )}
            </ul>
            <script
              type="application/json"
              id="desktop-files"
              set:html={JSON.stringify(download.files)}
            />
          </div>
        ) : (
          <StartWays locale={locale} />
        )}
      </>
    )}
  </section>
</Site>

<script>
  import { detectPlatform, fileFor } from "../lib/desktop-download.ts"

  // Points the download buttons at the file for this computer; without one they keep the
  // release page.
  type Hints = { platform?: string; mobile?: boolean; architecture?: string }
  type UserAgentData = {
    platform: string
    mobile: boolean
    getHighEntropyValues(keys: string[]): Promise<Hints>
  }
  const isUserAgentData = (value: unknown): value is UserAgentData =>
    typeof value === "object" && value !== null && "getHighEntropyValues" in value
  async function hints(): Promise<Hints | undefined> {
    const data: unknown = Reflect.get(navigator, "userAgentData")
    if (!isUserAgentData(data)) return undefined
    const named = { platform: data.platform, mobile: data.mobile }
    try {
      return { ...(await data.getHighEntropyValues(["architecture"])), ...named }
    } catch {
      return named
    }
  }
  const list = document.getElementById("desktop-files")
  if (list) {
    const files: { name: string; url: string }[] = JSON.parse(list.textContent ?? "[]")
    const platform = detectPlatform(navigator.userAgent, await hints())
    const file = platform && fileFor(platform, files)
    if (file) {
      for (const link of document.querySelectorAll<HTMLAnchorElement>("[data-desktop-download]")) {
        link.href = file.url
      }
      for (const note of document.querySelectorAll<HTMLElement>("[data-desktop-file]")) {
        note.textContent = file.name
        note.hidden = false
      }
    }
  }
</script>
