---
import { cn } from "cn"
import Icon from "./Icon.astro"
import Logo from "./Logo.astro"
import ThemeToggle from "./ThemeToggle.astro"
import { browseUrl } from "../catalog/data.ts"
import { chrome } from "../lib/chrome.ts"
import { starCount, starredRepo } from "../lib/github.ts"
import { siteNav } from "../lib/nav.ts"
import { homeUrl, locales, pathInLocale, type SiteLocale } from "../lib/urls.ts"

interface Props {
  locale: SiteLocale
  /** Which part of the site the page belongs to. */
  section?: "home" | "products" | "templates" | "docs" | "blog"
  /** The page in each locale, when it is not the same path. */
  alternates?: Partial<Record<SiteLocale, string>>
  /** Inside Starlight's own header bar, which supplies the outer element and padding. */
  docs?: boolean
}
const { locale, section, alternates = {}, docs = false } = Astro.props
const Outer = docs ? "div" : "header"
const t = chrome[locale]
const nav = await siteNav(locale)
const stars = await starCount(locale)
const here = Astro.url.pathname.replace(/\/$/, "") || "/"
const langHref = (l: SiteLocale) => alternates[l] ?? pathInLocale(here, l)
const current = (on: boolean) => (on ? "true" : undefined)
const isHere = (href: string) => (href === here ? "page" : undefined)
const navLink = "nav-item aria-[current]:underline aria-[current]:underline-offset-[0.4em]"
const show = docs ? "docs-nav:flex" : "nav:flex"
const links = [
  { href: browseUrl(locale), text: t.nav.templates, on: section === "templates" },
  { href: nav.docs, text: t.nav.docs, on: section === "docs" },
  { href: nav.security, text: t.nav.security, on: false },
  { href: nav.blog, text: t.nav.blog, on: section === "blog" },
]
---

<Outer
  class={cn(
    docs
      ? "docs-header h-full"
      : "sticky top-0 z-50 h-(--header-height) border-b border-site-line bg-site-bg print:hidden [view-transition-name:site-header]",
  )}
>
  <!-- On the landing the bar keeps to the page's container; in the docs, to Starlight's padding. -->
  <div class={cn("flex h-full items-center gap-3 text-sm", !docs && "wrap")}>
    <a
      href={homeUrl(locale)}
      class={cn(
        "inline-flex items-center gap-2 whitespace-nowrap text-site-text no-underline",
        docs && "docs:min-w-[calc(var(--sl-sidebar-width)-2*var(--sl-nav-pad-x))]",
      )}
      aria-label={`Zeabur ${t.nav.openSource}, ${t.nav.home}`}
    >
      <Logo />
      <span class="label leading-none" translate="no">
        {t.nav.openSource}
      </span>
    </a>
    <nav class={cn("hidden items-center", show)} aria-label={`Zeabur ${t.nav.openSource}`}>
      <details class="menu static" data-menu>
        <summary class="nav-item" aria-current={current(section === "products")}>
          {t.nav.product}
          <Icon name="caret-down" class="size-3" />
        </summary>
        <div class="menu-panel inset-x-0 top-full grid border-x-0 border-t-0 md:grid-cols-3">
          {nav.product.map((group) => (
            <div class="border-site-line p-4 not-first:border-l">
              <p class="label px-3 pb-2 text-site-faint">{group.title}</p>
              {group.items.map((item) => (
                <a href={item.href} aria-current={isHere(item.href)} class="items-start">
                  <span class="grid min-w-0 gap-0.5">
                    <span class="flex flex-wrap items-center gap-2 font-semibold">
                      {item.name}
                      {item.soon && <span class="soon">{t.nav.soon}</span>}
                    </span>
                    {item.line && <span class="type-body opacity-75">{item.line}</span>}
                  </span>
                </a>
              ))}
            </div>
          ))}
        </div>
      </details>
      <details class="menu" data-menu>
        <summary class="nav-item">
          {t.nav.useCases}
          <Icon name="caret-down" class="size-3" />
        </summary>
        <div class="menu-panel left-0 w-[20rem]">
          {nav.useCases.map((item) => (
            <a href={item.href} class="items-start">
              <span class="grid gap-0.5">
                <span class="font-semibold">{item.name}</span>
                <span class="type-body opacity-75">{item.line}</span>
              </span>
            </a>
          ))}
        </div>
      </details>
      {links.map(({ href, text, on }) => (
        <a href={href} class={navLink} aria-current={current(on)}>
          {text}
        </a>
      ))}
    </nav>
    {Astro.slots.has("search") && (
      <div class="flex flex-1 justify-end docs:justify-start">
        <slot name="search" />
      </div>
    )}
    <div class="ml-auto flex items-center gap-1 [&_.icon]:size-4">
      <details class={cn("menu", docs && "max-docs:hidden")} data-menu>
        <summary class="nav-item" aria-label={t.nav.language}>
          <Icon name="translate" />
          <span class="max-[30rem]:hidden">{t.lang}</span>
        </summary>
        <div class="menu-panel right-0">
          {locales.map((l) => (
            <a
              href={langHref(l)}
              hreflang={l}
              lang={l}
              aria-current={l === locale ? "page" : undefined}
            >
              {chrome[l].lang}
            </a>
          ))}
        </div>
      </details>
      <ThemeToggle label={t.nav.theme} />
      <a
        href={starredRepo}
        class={cn("nav-item px-2", docs && "max-docs:hidden")}
        aria-label={stars ? `${t.nav.github}, ${t.nav.stars(stars)}` : t.nav.github}
      >
        <Icon name="github-logo" />
        {stars && <span class="font-mono text-xs max-[30rem]:hidden">{stars}</span>}
      </a>
      {!docs && (
        <a href={nav.start} class="button primary ml-2 hidden min-h-9 px-3 text-sm nav:inline-flex">
          {t.nav.start}
        </a>
      )}
      {!docs && (
        // Small screens: one menu button opens the whole navigation. The docs have Starlight's.
        <details class="menu nav:hidden" data-menu>
          <summary class="icon-button" aria-label={t.nav.menu}>
            <Icon name="list" />
          </summary>
          <div class="menu-panel fixed inset-x-0 top-(--header-height) max-h-[calc(100dvh-var(--header-height))] overflow-y-auto border-x-0 border-t-0 px-(--gutter) pb-6">
            {nav.product.map((group) => (
              <>
                <p class="label pt-5 pb-1 text-site-faint">{group.title}</p>
                {group.items.map((item) => (
                  <a href={item.href} class="-mx-3 flex-wrap">
                    {item.name}
                    {item.soon && <span class="soon">{t.nav.soon}</span>}
                  </a>
                ))}
              </>
            ))}
            <p class="label pt-5 pb-1 text-site-faint">{t.nav.useCases}</p>
            {nav.useCases.map((item) => (
              <a href={item.href} class="-mx-3">
                {item.name}
              </a>
            ))}
            <p class="label pt-5 pb-1 text-site-faint">{`Zeabur ${t.nav.openSource}`}</p>
            {links.map(({ href, text }) => (
              <a href={href} class="-mx-3">
                {text}
              </a>
            ))}
            <a href={nav.start} class="button primary mt-5 w-full text-base">
              {t.nav.start}
            </a>
          </div>
        </details>
      )}
    </div>
  </div>
</Outer>

<script>
  // One menu open at a time. A click outside, Escape, or Tab out of a menu closes it; Escape puts
  // focus back on the menu's button, so focus never falls to the page.
  function closeMenus(except?: Element) {
    for (const menu of document.querySelectorAll<HTMLDetailsElement>("[data-menu][open]")) {
      if (menu !== except) menu.open = false
    }
  }
  document.addEventListener("click", (event) => {
    const target = event.target as Element
    const menu = target.closest("[data-menu]")
    closeMenus(menu ?? undefined)
    if (menu && target.closest(".menu-panel a")) (menu as HTMLDetailsElement).open = false
  })
  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return
    const open = document.querySelector<HTMLDetailsElement>("[data-menu][open]")
    if (!open) return
    open.open = false
    open.querySelector("summary")?.focus()
  })
  document.addEventListener("focusout", (event) => {
    const menu = (event.target as Element).closest<HTMLDetailsElement>("[data-menu][open]")
    const next = event.relatedTarget as Node | null
    if (menu && next && !menu.contains(next)) menu.open = false
  })
</script>
