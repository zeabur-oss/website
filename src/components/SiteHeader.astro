---
import { cn } from "cn"
import Icon from "./Icon.astro"
import Logo from "./Logo.astro"
import NavEntry from "./NavEntry.astro"
import ThemeToggle from "./ThemeToggle.astro"
import { githubOrg } from "../lib/site.ts"
import { chrome } from "../lib/chrome.ts"
import { githubStars, shortCount } from "../lib/github.ts"
import { siteNav } from "../lib/nav.ts"
import { homeUrl, locales, pathInLocale, type SiteLocale } from "../lib/urls.ts"

interface Props {
  locale: SiteLocale
  /** Which part of the site the page belongs to. */
  section?: "home" | "products" | "docs" | "blog"
  /** The page in each locale, when it is not the same path. */
  alternates?: Partial<Record<SiteLocale, string>>
  /** Inside Starlight's own header bar, which supplies the outer element and padding. */
  docs?: boolean
}
const { locale, section, alternates = {}, docs = false } = Astro.props
const Outer = docs ? "div" : "header"
const t = chrome[locale]
const nav = siteNav(locale)
const here = Astro.url.pathname.replace(/\/$/, "") || "/"
const langHref = (l: SiteLocale) => alternates[l] ?? pathInLocale(here, l)
const current = (on: boolean) => (on ? "true" : undefined)
const navLink = "nav-item aria-[current=true]:font-medium aria-[current=true]:text-site-text"
const caret = "size-3 transition-[rotate] duration-quick ease-(--ease-site) group-open:rotate-180"
const stars = await githubStars()
const starCount = stars === undefined ? undefined : shortCount(stars, locale)
const repo = `${githubOrg}/zeabur`
const links = [
  {
    href: nav.docs,
    text: t.nav.docs,
    icon: "book-open",
    on: section === "docs" && here !== nav.trust,
  },
  { href: nav.trust, text: t.nav.trust, icon: "shield-check", on: here === nav.trust },
  { href: nav.blog, text: t.nav.blog, icon: "article", on: section === "blog" },
]
---

<Outer
  class={cn(
    docs
      ? "docs-header h-full"
      : "sticky top-0 z-50 h-(--header-height) print:hidden border-b border-site-line bg-[color-mix(in_srgb,var(--site-bg)_88%,transparent)] [backdrop-filter:saturate(1.4)_blur(12px)] [view-transition-name:site-header]",
  )}
>
  <!-- The same bar as the docs header (Starlight's padding and sidebar width), so nothing in it
       moves between the landing and the docs. -->
  <div class={cn("flex h-full items-center gap-4 text-sm font-normal", !docs && "px-4 docs:px-6")}>
    <a
      href={homeUrl(locale)}
      class={cn(
        "inline-flex items-center gap-2 whitespace-nowrap text-site-text no-underline",
        docs
          ? "docs:min-w-[calc(var(--sl-sidebar-width)-2*var(--sl-nav-pad-x))]"
          : "docs:min-w-[13.5rem]",
      )}
      aria-label={`Zeabur ${t.nav.openSource}, ${t.nav.home}`}
    >
      <Logo />
      <span class="text-base leading-none font-medium text-site-muted" translate="no">
        {t.nav.openSource}
      </span>
    </a>
    <nav
      class={cn("hidden items-center gap-0.5", docs ? "docs-wide:flex" : "nav:flex")}
      aria-label={`Zeabur ${t.nav.openSource}`}
    >
      <details class="menu group" data-menu>
        <summary class="nav-item" aria-current={current(section === "products")}>
          {t.nav.products}
          <Icon name="caret-down" class={caret} />
        </summary>
        <div class="menu-panel left-0 grid w-[24rem] p-2">
          {nav.products.map((item) => (
            <NavEntry item={item} current={here === item.href} />
          ))}
        </div>
      </details>
      <details class="menu group" data-menu>
        <summary class="nav-item">
          {t.nav.useCases}
          <Icon name="caret-down" class={caret} />
        </summary>
        <div class="menu-panel left-0 grid w-[19rem] p-2">
          {nav.useCases.map((item) => (
            <NavEntry item={item} current={false} />
          ))}
        </div>
      </details>
      {links.map(({ href, text, on }) => (
        <a href={href} class={navLink} aria-current={current(on)}>
          {text}
        </a>
      ))}
    </nav>
    {Astro.slots.has("search") && (
      <div class="flex flex-1 justify-end docs:justify-start">
        <slot name="search" />
      </div>
    )}
    <div class="ml-auto flex items-center gap-1 [&_.icon]:size-4">
      <details class={cn("menu", docs && "max-docs:hidden")} data-menu>
        <summary class="nav-item" aria-label={t.nav.language}>
          <Icon name="translate" />
          <span class={docs ? "max-[84rem]:hidden" : "max-[78rem]:hidden"}>{t.lang}</span>
        </summary>
        <div class="menu-panel right-0">
          {locales.map((l) => (
            <a
              href={langHref(l)}
              hreflang={l}
              lang={l}
              aria-current={l === locale ? "page" : undefined}
            >
              {chrome[l].lang}
            </a>
          ))}
        </div>
      </details>
      <ThemeToggle label={t.nav.theme} />
      <a
        href={repo}
        class={cn("nav-item gap-2 max-[26rem]:hidden", docs && "max-docs:hidden")}
        aria-label={starCount === undefined ? t.nav.github : t.nav.stars(starCount)}
      >
        <Icon name="github-logo" />
        <span class={docs ? "hidden" : "max-nav:hidden"}>GitHub</span>
        {starCount !== undefined && (
          <span class="inline-flex items-center gap-1 font-mono text-[0.75rem] text-site-faint">
            <Icon name="star" weight="fill" class="!size-3" />
            {starCount}
          </span>
        )}
      </a>
      {!docs && (
        <a href={nav.start} class="button primary ml-1 h-8 px-3 max-[30rem]:hidden">
          {t.nav.start}
        </a>
      )}
      {!docs && (
        // Small screens: one menu button opens the whole navigation. The docs have Starlight's.
        <details class="menu nav:hidden" data-menu>
          <summary class="icon-button" aria-label={t.nav.menu}>
            <Icon name="list" />
          </summary>
          <div class="menu-panel fixed top-(--header-height) right-0 left-0 max-h-[calc(100dvh-var(--header-height))] overflow-y-auto rounded-none border-x-0 px-(--gutter) pt-2 pb-4">
            <p class="menu-label">{t.nav.products}</p>
            {nav.products.map(({ href, icon, name, soon }) => (
              <a href={href} class="px-2 py-2.5">
                {icon && <Icon name={icon} />}
                {name}
                {soon && <span class="soon">Coming soon</span>}
              </a>
            ))}
            <p class="menu-label">{t.nav.useCases}</p>
            {nav.useCases.map(({ href, name }) => (
              <a href={href} class="px-2 py-2.5">
                {name}
              </a>
            ))}
            <p class="menu-label">{`Zeabur ${t.nav.openSource}`}</p>
            {links.map(({ href, icon, text }) => (
              <a href={href} class="px-2 py-2.5">
                <Icon name={icon} />
                {text}
              </a>
            ))}
            <a href={repo} class="px-2 py-2.5">
              <Icon name="github-logo" />
              GitHub
            </a>
            <a href={nav.start} class="button primary mt-3 w-full !text-(--on-primary)">
              {t.nav.start}
            </a>
          </div>
        </details>
      )}
    </div>
  </div>
</Outer>

<script>
  // One menu open at a time. A click outside, Escape, or focus that leaves the menu closes it.
  function closeMenus(except?: Element) {
    for (const menu of document.querySelectorAll<HTMLDetailsElement>("[data-menu][open]")) {
      if (menu !== except) menu.open = false
    }
  }
  document.addEventListener("click", (event) => {
    const target = event.target as Element
    const menu = target.closest("[data-menu]")
    closeMenus(menu ?? undefined)
    if (menu && target.closest(".menu-panel a")) (menu as HTMLDetailsElement).open = false
  })
  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return
    const open = document.querySelector<HTMLDetailsElement>("[data-menu][open]")
    closeMenus()
    if (open?.contains(document.activeElement)) open.querySelector("summary")?.focus()
  })
  document.addEventListener("focusin", (event) => {
    closeMenus((event.target as Element).closest("[data-menu]") ?? undefined)
  })
</script>
