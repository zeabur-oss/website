---
import Logo from "./Logo.astro"
import { githubOrg } from "../lib/site.ts"
import { chrome } from "../lib/chrome.ts"
import { siteNav } from "../lib/nav.ts"
import { type SiteLocale } from "../lib/urls.ts"
import { catalogCopy } from "../catalog/copy.ts"
import { browseUrl } from "../catalog/data.ts"

interface Props {
  locale: SiteLocale
}
const { locale } = Astro.props
const t = chrome[locale]
const nav = await siteNav(locale)
const columns = [
  { title: t.nav.product, links: nav.product.flatMap((g) => g.items).filter((i) => i.line) },
  { title: t.nav.useCases, links: nav.useCases },
  {
    title: t.footer.resources,
    links: [
      { name: t.nav.docs, href: nav.docs },
      { name: t.nav.security, href: nav.security },
      { name: catalogCopy[locale].title, href: browseUrl(locale) },
      { name: t.nav.blog, href: nav.blog },
      { name: "RSS", href: `${nav.blog}/rss.xml` },
      { name: "GitHub", href: githubOrg },
    ],
  },
]
---

<footer class="border-t border-site-line print:hidden [view-transition-name:site-footer]">
  <div class="wrap grid gap-10 py-12 md:grid-cols-12 md:gap-x-6">
    <div class="md:col-span-4">
      <Logo class="h-5" />
      <p class="mt-4 max-w-[24rem] text-sm leading-[1.6] text-site-muted">{t.footer.about}</p>
      <p class="label mt-6 text-site-faint">© Zeabur · {t.footer.license}</p>
    </div>
    <div class="grid gap-8 sm:grid-cols-3 md:col-span-8">
      {columns.map(({ title, links }) => (
        <div>
          <h2 class="label mb-3 font-medium tracking-[0.06em] text-site-faint">{title}</h2>
          <ul class="m-0 grid list-none p-0">
            {links.map(({ href, name, soon }: { href: string; name: string; soon?: boolean }) => (
              <li>
                <a
                  href={href}
                  class="inline-flex min-h-8 items-center gap-2 text-sm text-site-text no-underline hover:underline hover:underline-offset-4"
                >
                  {name}
                  {soon && <span class="soon">{t.nav.soon}</span>}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</footer>
