---
// PostHog web analytics without cookies or storage (cookieless_mode "always"): visitors are
// counted with a hash PostHog makes on its servers, so no banner is needed. Only a build with
// PUBLIC_POSTHOG_KEY (the deploy on main, .github/workflows/pages.yml) sends anything.
---

<script>
  import { firstLine, linkEvent, type CodeBlock, type SiteEvent } from "../lib/analytics.ts"

  // Which block was copied: the heading above it, the tab it sits in, its place on the page and
  // its first line. The code is the page's own, never anything a visitor typed.
  function codeBlock(block: Element, code: string, by: CodeBlock["by"]): CodeBlock {
    const blocks = [
      ...document.querySelectorAll("main :is(.expressive-code, pre:not(.expressive-code pre))"),
    ]
    const heading = [...document.querySelectorAll("main :is(h2, h3)[id]")]
      .filter((h) => h.compareDocumentPosition(block) & Node.DOCUMENT_POSITION_FOLLOWING)
      .at(-1)
    const panel = block.closest("[role=tabpanel]")
    const tab = panel && document.getElementById(panel.getAttribute("aria-labelledby") ?? "")
    return {
      by,
      language: block.querySelector("pre")?.dataset.language,
      heading: heading?.id,
      tab: tab?.textContent?.trim(),
      index: blocks.indexOf(block),
      first_line: firstLine(code),
    }
  }

  function selectedBlock(): { block: Element; code: string } | undefined {
    const selection = document.getSelection()
    const node = selection?.anchorNode
    const element = node instanceof Element ? node : node?.parentElement
    const pre = element?.closest("main pre")
    if (!selection || !pre) return undefined
    return { block: pre.closest(".expressive-code") ?? pre, code: selection.toString() }
  }

  async function start(key: string) {
    const { posthog } = await import("posthog-js/dist/module.no-external")
    posthog.init(key, {
      api_host: "https://oss-nori.zeabur.com",
      ui_host: "https://us.posthog.com",
      cookieless_mode: "always",
      person_profiles: "never",
      capture_pageview: "history_change",
      disable_session_recording: true,
      disable_surveys: true,
      disable_product_tours: true,
      disable_conversations: true,
      advanced_disable_flags: true,
    })
    return (event: SiteEvent) => posthog.capture(event.name, event.props)
  }

  // Each page view sends start_seen once, when the start section first comes into view.
  let watching: IntersectionObserver | undefined
  function watchStart(send: (event: SiteEvent) => void) {
    watching?.disconnect()
    const target = document.getElementById("start")
    if (!target) return
    watching = new IntersectionObserver((entries, observer) => {
      if (!entries.some((entry) => entry.isIntersecting)) return
      observer.disconnect()
      send({ name: "start_seen", props: {} })
    })
    watching.observe(target)
  }

  const key = import.meta.env.PUBLIC_POSTHOG_KEY
  if (key) {
    const sender = start(key)

    document.addEventListener("click", (event) => {
      if (!(event.target instanceof Element)) return
      const copy = event.target.closest<HTMLElement>(".expressive-code .copy button")
      const block = copy?.closest(".expressive-code")
      const found: SiteEvent | undefined =
        copy && block
          ? { name: "code_copied", props: codeBlock(block, copy.dataset.code ?? "", "button") }
          : linkEvent(event.target.closest("a")?.href ?? "")
      if (found) void sender.then((send) => send(found))
    })

    document.addEventListener("copy", () => {
      const selected = selectedBlock()
      if (!selected) return
      const props = codeBlock(selected.block, selected.code, "selection")
      void sender.then((send) => send({ name: "code_copied", props }))
    })

    document.addEventListener("astro:page-load", () => void sender.then(watchStart))
  }
</script>
