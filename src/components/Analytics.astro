---
// PostHog web analytics without cookies or storage (cookieless_mode "always"): visitors are
// counted with a hash PostHog makes on its servers, so no banner is needed. Only a build with
// PUBLIC_POSTHOG_KEY (the deploy on main, .github/workflows/pages.yml) sends anything.
---

<script>
  const repoLink = /^https:\/\/github\.com\/zeabur-oss(?:\/([^/?#]+)(\/releases)?)?(?:[/?#]|$)/

  // Which block was copied: the heading above it, the tab it sits in, its place on the page and
  // its first line. The code is the docs' own, never anything a visitor typed.
  function codeBlock(button: HTMLElement) {
    const block = button.closest(".expressive-code")!
    const blocks = [...document.querySelectorAll("main .expressive-code")]
    const heading = [...document.querySelectorAll("main :is(h2, h3)[id]")]
      .filter((h) => h.compareDocumentPosition(block) & Node.DOCUMENT_POSITION_FOLLOWING)
      .at(-1)
    const panel = block.closest("[role=tabpanel]")
    const tab = panel && document.getElementById(panel.getAttribute("aria-labelledby") ?? "")
    return {
      language: block.querySelector("pre")?.dataset.language,
      heading: heading?.id,
      tab: tab?.textContent?.trim(),
      index: blocks.indexOf(block),
      first_line: (button.dataset.code ?? "")
        .split(/[\n\u007f]/)[0]!
        .trim()
        .slice(0, 120),
    }
  }

  async function start(key: string) {
    const { posthog } = await import("posthog-js/dist/module.no-external")
    posthog.init(key, {
      api_host: "https://us.i.posthog.com",
      cookieless_mode: "always",
      person_profiles: "never",
      capture_pageview: "history_change",
      disable_session_recording: true,
      disable_surveys: true,
      disable_product_tours: true,
      disable_conversations: true,
      advanced_disable_flags: true,
    })

    document.addEventListener("click", (event) => {
      if (!(event.target instanceof Element)) return
      const copy = event.target.closest<HTMLElement>(".expressive-code .copy button")
      if (copy) {
        posthog.capture("code_copied", codeBlock(copy))
        return
      }
      const href = event.target.closest("a")?.href
      const repo = href && repoLink.exec(href)
      if (!repo) return
      posthog.capture(repo[2] ? "releases_clicked" : "github_clicked", { repo: repo[1] })
    })
  }

  const key = import.meta.env.PUBLIC_POSTHOG_KEY
  if (key) void start(key)
</script>
