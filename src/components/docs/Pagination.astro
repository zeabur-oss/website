---
import Icon from "../Icon.astro"

// Previous and next stay inside the repository (src/route-data.ts). Small, so the page ends on
// its own content rather than on two large cards.
const { pagination } = Astro.locals.starlightRoute
const { prev, next } = pagination
const link =
  "flex flex-col gap-0.5 rounded-lg border border-site-line px-3.5 py-2.5 no-underline transition-[border-color] duration-quick ease-(--ease-site) hover:border-site-line-strong"
const label = "inline-flex items-center gap-1 type-meta text-site-faint"
const title = "text-sm leading-[1.4] font-medium text-site-text"
---

<nav
  class="grid grid-cols-2 gap-3 print:hidden"
  aria-label={`${Astro.locals.t("page.previousLink")} / ${Astro.locals.t("page.nextLink")}`}
>
  {prev ? (
    <a href={prev.href} rel="prev" class={link}>
      <span class={label}>
        <Icon name="arrow-left" />
        {Astro.locals.t("page.previousLink")}
      </span>
      <span class={title}>{prev.label}</span>
    </a>
  ) : (
    <span />
  )}
  {next && (
    <a href={next.href} rel="next" class={`${link} col-start-2 items-end text-end`}>
      <span class={label}>
        {Astro.locals.t("page.nextLink")}
        <Icon name="arrow-right" />
      </span>
      <span class={title}>{next.label}</span>
    </a>
  )}
</nav>
