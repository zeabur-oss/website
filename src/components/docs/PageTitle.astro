---
import { Aside } from "@astrojs/starlight/components"
import { releasePage } from "../../lib/releases.ts"

// The title, the description as the lead, a notice when the page is not in the reader's
// language (scripts/sync-docs.ts falls back to another one), and one on the docs of main.
const notices: Record<string, Record<string, string>> = {
  en: { "zh-TW": "This page is only available in Traditional Chinese for now." },
  "zh-TW": { en: "這一頁還沒有繁體中文版，以下是英文原文。" },
  "zh-CN": {
    en: "这一页还没有简体中文版，以下是英文原文。",
    "zh-TW": "这一页还没有简体中文版，以下是繁体中文版。",
  },
}
const unreleased: Record<
  string,
  { text: (commit: string) => string; page: (tag: string) => string; docs: (tag: string) => string }
> = {
  en: {
    text: (commit) => `This page describes unreleased work on main (${commit}).`,
    page: (tag) => `Read this page for ${tag}`,
    docs: (tag) => `Read the docs for ${tag}`,
  },
  "zh-TW": {
    text: (commit) => `這一頁說明 main 分支上還沒發布的內容（${commit}）。`,
    page: (tag) => `看 ${tag} 的這一頁`,
    docs: (tag) => `看 ${tag} 的文件`,
  },
  "zh-CN": {
    text: (commit) => `这一页说明 main 分支上还没发布的内容（${commit}）。`,
    page: (tag) => `看 ${tag} 的这一页`,
    docs: (tag) => `看 ${tag} 的文档`,
  },
}
const { entry, lang } = Astro.locals.starlightRoute
const data = entry.data as {
  title: string
  description?: string
  contentLocale?: string
  repo?: string
}
const notice = data.contentLocale && notices[lang]?.[data.contentLocale]
const release = data.repo && releasePage(lang, data.repo, Astro.url.pathname)
const words = unreleased[lang] ?? unreleased.en
---

<h1
  id="_top"
  class="mt-4 text-[clamp(1.75rem,1.5rem+1vw,2.25rem)] leading-[1.2] font-semibold tracking-[-0.02em] text-balance text-(--sl-color-white)"
>
  {data.title}
</h1>
{data.description && (
  <p class="mt-3 max-w-[40rem] text-lg leading-[1.7] text-secondary">{data.description}</p>
)}
{release && words && (
  <div class="mt-5">
    <Aside type="note">
      {words.text(release.commit.slice(0, 7))}{" "}
      <a href={release.href}>{(release.same ? words.page : words.docs)(release.tag)}</a>
    </Aside>
  </div>
)}
{notice && (
  <div class="mt-5">
    <Aside type="note">{notice}</Aside>
  </div>
)}
