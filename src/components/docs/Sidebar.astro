---
import ProductLink from "../ProductLink.astro"
import Default from "@astrojs/starlight/components/Sidebar.astro"
import Icon from "../Icon.astro"
import { chrome } from "../../lib/chrome.ts"
import { productIcon, productIds, productName, type ProductId } from "../../lib/products.ts"
import { blogUrl, docsUrl, homeUrl, isSiteLocale } from "../../lib/urls.ts"

// The product whose docs these are, as a menu at the top, then that product's pages.
const { lang, entry } = Astro.locals.starlightRoute
const locale = isSiteLocale(lang) ? lang : "en"
const t = chrome[locale]
const current = (entry.data as { repo?: string }).repo as ProductId | undefined
---

{current && (
  <details class="menu group mb-1" data-menu>
    <summary class="flex h-11 cursor-pointer items-center gap-2.5 rounded-lg border border-site-line bg-site-card py-0 pr-2.5 pl-1.5 text-sm font-medium text-site-text no-underline transition-[color,background-color] duration-quick ease-(--ease-site) group-open:border-site-line-strong hover:border-site-line-strong">
      <span class="mark size-7">
        <Icon name={productIcon[current]} class="size-4" />
      </span>
      <span class="flex-1">{productName[current]}</span>
      <Icon name="caret-up-down" class="size-3.5 text-site-faint" />
    </summary>
    <div class="menu-panel right-0 left-0 grid gap-0.5">
      {productIds.map((id) => (
        <ProductLink
          id={id}
          href={docsUrl(locale, id)}
          current={id === current}
          name={productName[id]}
          line={t.products[id].short}
        />
      ))}
    </div>
  </details>
)}
<Default />
<nav
  class="flex gap-4 border-t border-site-line pt-4 pb-2 text-sm docs:hidden"
  aria-label="Zeabur Open Source"
>
  {[
    { href: homeUrl(locale), icon: "house", text: t.nav.home },
    { href: blogUrl(locale), icon: "article", text: t.nav.blog },
  ].map(({ href, icon, text }) => (
    <a href={href} class="inline-flex items-center gap-1.5 text-site-muted no-underline">
      <Icon name={icon} />
      {text}
    </a>
  ))}
</nav>
