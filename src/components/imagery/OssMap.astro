---
// How the projects meet in one cluster: Zeabur, kubectl and an AI assistant sign in through
// Zeabur Identity, GitOps runs in the cluster, and every request goes through the API server with
// the caller's own RBAC.
interface Props {
  label: string
}
const clients = [
  { kind: "browser", name: "Zeabur", via: true },
  { kind: "terminal", name: "kubectl", via: true },
  { kind: "zeaburctl mcp", name: "AI assistant", via: true },
  { kind: "GitOps", name: "Argo CD · Flux", via: false },
]
const objects = [
  { kind: "your services", name: "Deployment" },
  { kind: "Zeabur Builder", name: "Build" },
  { kind: "Zeabur Catalog", name: "HelmChart" },
  { kind: "operators", name: "database" },
]
const x = (i: number) => 40 + i * 148
const w = 128
const mid = (i: number) => x(i) + w / 2
---

<svg class="imagery imagery-map" viewBox="0 0 640 352" role="img" aria-label={Astro.props.label}>
  <rect class="img-frame" x="16" y="16" width="608" height="320" rx="6"></rect>

  {clients.map((c, i) => (
    <g>
      <rect class="img-card" x={x(i)} y="36" width={w} height="52" rx="6" />
      <text class="img-kind" x={x(i) + 12} y="56">
        {c.kind}
      </text>
      <text class="img-name" x={x(i) + 12} y="75">
        {c.name}
      </text>
      <path class="img-link" d={c.via ? `M${mid(i)} 88 V112` : `M${mid(i)} 88 V176`} />
    </g>
  ))}

  <rect class="img-box" x="40" y="112" width="424" height="38" rx="6"></rect>
  <text class="img-strong img-name" x="52" y="136">
    Zeabur Identity
  </text>
  <text class="img-kind" x="452" y="135" text-anchor="end">
    passkey → token for minutes
  </text>
  {clients.slice(0, 3).map((_, i) => (
    <path class="img-link" d={`M${mid(i)} 150 V176`} />
  ))}

  <rect class="img-box img-box-accent" x="40" y="176" width="572" height="38" rx="6"></rect>
  <text class="img-strong img-name" x="52" y="200">
    kube-apiserver
  </text>
  <text class="img-kind" x="600" y="199" text-anchor="end">
    each request with its own RBAC
  </text>
  <path class="img-link img-accent-stroke" d="M326 214 V232"></path>

  <rect class="img-group" x="40" y="232" width="572" height="88" rx="6"></rect>
  <text class="img-kind" x="52" y="250">
    cluster
  </text>
  {objects.map((o, i) => (
    <g>
      <rect class="img-card" x={x(i) + 8} y="258" width={w - 16} height="50" rx="6" />
      <text class="img-kind" x={x(i) + 18} y="277">
        {o.kind}
      </text>
      <text class="img-name" x={x(i) + 18} y="296">
        {o.name}
      </text>
    </g>
  ))}
</svg>
