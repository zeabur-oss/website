---
// Breaks Chinese only between words: keep-all holds each word together, <wbr> marks the gaps,
// and text-wrap picks among them.
import { localeInfo } from "../lib/urls.ts"
import { chineseTextSegments } from "./chinese-text.ts"

interface Props {
  text: string
  /** Defaults to the page's locale. */
  locale?: string
}
const { text } = Astro.props
const locale = Astro.props.locale ?? Astro.currentLocale ?? "en"
const plain = localeInfo(locale).han === null || !/\p{Script=Han}/u.test(text)
---

{plain ? (
  text
) : (
  <span class="zh-words">
    {chineseTextSegments(text, locale).map((word, i) => (
      <Fragment>
        {i > 0 && word.trim() && <wbr />}
        {word}
      </Fragment>
    ))}
  </span>
)}
