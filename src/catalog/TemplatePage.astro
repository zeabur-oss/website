---
import type { CatalogTemplate } from "../../scripts/lib/catalog.ts"
import Icon from "../components/Icon.astro"
import { catalogPromptDocs } from "../lib/agent-guide.ts"
import { docsUrl, productUrl, type SiteLocale } from "../lib/urls.ts"
import { catalogCopy } from "./copy.ts"
import { catalog, entryUrl, formatBytes, formatCpu, markdown } from "./data.ts"
import EntryPage from "./EntryPage.astro"
import Pills from "./Pills.astro"
import Section from "./Section.astro"
import "../blog/prose.css"

interface Props {
  locale: SiteLocale
  template: CatalogTemplate
}
const { locale, template: x } = Astro.props
const t = catalogCopy[locale]
const w = t.template
const componentName = new Map(catalog.components.map((c) => [c.id, c.name]))
const cores = (q: string) => w.resources.cores(formatCpu(q))
const render = await markdown
const readme = await Promise.all(
  x.readme[locale].map(async (s) => ({ ...s, html: (await render.render(s.markdown)).code })),
)
const [intro, ...rest] = readme
const agent = catalogPromptDocs(locale, "templates")
---

<EntryPage
  locale={locale}
  kind="templates"
  entry={x}
  title={w.pageTitle(x.name)}
  facts={[{ label: t.facts.version, value: x.version }]}
  actions={[
    { href: docsUrl(locale, "zeabur", "deploy/templates"), text: w.deploy, icon: "arrow-right" },
    ...(agent
      ? [
          {
            href: `${productUrl(locale, "agent")}?id=${x.id}#templates`,
            text: t.agent,
            icon: "terminal",
          },
        ]
      : []),
    { href: x.homepage, text: t.about(x.name), icon: "arrow-up-right" },
  ]}
>
  {intro && (
    <Section id={intro.id} title={intro.title}>
      <div class="prose min-w-0" set:html={intro.html} />
    </Section>
  )}

  <Section id="values" title={w.values.title}>
    {x.provided.length === 0 && <p class="body">{w.values.none}</p>}
    {x.provided.length > 0 && (
      <ul class="grid list-none p-0">
        {x.provided.map((v) => (
          <li class="grid gap-2 border-t border-site-line py-5">
            <p class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
              <span class="font-semibold">{v.label[locale]}</span>
              <span class="label text-site-faint">
                {v.required ? w.values.required : w.values.optional}
              </span>
            </p>
            <p class="body">{v.description[locale]}</p>
            {v.default !== undefined && (
              <p class="text-sm text-site-muted">
                {w.values.default}: <code class="font-mono break-all">{v.default}</code>
              </p>
            )}
          </li>
        ))}
      </ul>
    )}
    {x.generated.length > 0 && (
      <div class="grid gap-3">
        <h3 class="label text-site-faint">{w.values.generated}</h3>
        <p class="body">{w.values.generatedBody}</p>
        <Pills items={x.generated.map((text) => ({ text, mono: true }))} />
      </div>
    )}
  </Section>

  {rest.map((r) => (
    <Section id={r.id} title={r.title}>
      <div class="prose min-w-0" set:html={r.html} />
      {r.id === "getting-started" && (
        <div class="flex flex-wrap gap-x-8 gap-y-4">
          <a href={docsUrl(locale, "zeabur", "deploy/templates")} class="more">
            <Icon name="arrow-right" />
            {w.start.deploy}
          </a>
          <a href={x.docs} class="more">
            <Icon name="arrow-up-right" />
            {w.start.docs(x.name)}
          </a>
        </div>
      )}
    </Section>
  ))}

  <Section id="resources" title={w.resources.title} body={w.resources.body}>
    <ul class="grid list-none p-0">
      {x.services.map((s) => (
        <li class="grid gap-4 border-t border-site-line py-5 sm:grid-cols-2 lg:grid-cols-4 lg:gap-6">
          <p class="font-mono font-semibold break-all">{s.name}</p>
          <div class="grid content-start gap-1.5">
            <p class="label text-site-faint">{w.resources.ports}</p>
            <p class="font-mono text-sm">
              {s.ports.length ? s.ports.map((p) => p.port).join(", ") : "–"}
            </p>
          </div>
          <div class="grid content-start gap-1.5">
            <p class="label text-site-faint">{w.resources.cpu}</p>
            <p class="text-sm">{w.resources.range(cores(s.requests.cpu), cores(s.limits.cpu))}</p>
          </div>
          <div class="grid content-start gap-1.5">
            <p class="label text-site-faint">{w.resources.memory}</p>
            <p class="text-sm">
              {w.resources.range(formatBytes(s.requests.memory), formatBytes(s.limits.memory))}
            </p>
          </div>
        </li>
      ))}
    </ul>
  </Section>

  <Section slot="details" id="security" title={t.security}>
    <p class="body">{x.security.summary[locale]}</p>
    {x.security.risks.length > 0 && (
      <div>
        <h3 class="label text-site-faint">{w.risks.title}</h3>
        <ol class="mt-4 grid list-none p-0">
          {x.security.risks.map((r) => (
            <li class="grid gap-3 border-t border-site-line py-5 md:grid-cols-2 md:gap-6">
              <div class="grid content-start gap-1.5">
                <p class="label text-site-faint">{w.risks.risk}</p>
                <p class="body">{r.risk[locale]}</p>
              </div>
              <div class="grid content-start gap-1.5">
                <p class="label text-site-faint">{w.risks.mitigation}</p>
                <p class="body">{r.mitigation[locale]}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    )}
  </Section>

  <Section slot="details" id="needs" title={w.needs.title} body={w.needs.body}>
    {x.requires.length > 0 && (
      <Pills
        items={x.requires.map((id) => ({
          text: componentName.get(id) ?? id,
          href: componentName.has(id) ? entryUrl(locale, "components", id) : undefined,
        }))}
      />
    )}
    <a href={docsUrl(locale, "catalog", "get-started/deploy-a-template")} class="more">
      <Icon name="terminal" />
      {w.deployCli}
    </a>
  </Section>
</EntryPage>
