---
import type { CatalogComponent } from "../../scripts/lib/catalog.ts"
import Icon from "../components/Icon.astro"
import CommandBlock from "../landing/CommandBlock.astro"
import { docsUrl, markdownPath, siteOrigin, type SiteLocale } from "../lib/urls.ts"
import { catalogCopy } from "./copy.ts"
import { catalog, entryUrl, markdown } from "./data.ts"
import EntryPage from "./EntryPage.astro"
import Pills from "./Pills.astro"
import Section from "./Section.astro"
import "../blog/prose.css"

interface Props {
  locale: SiteLocale
  component: CatalogComponent
}
const { locale, component: x } = Astro.props
const t = catalogCopy[locale]
const w = t.component
const componentName = new Map(catalog.components.map((c) => [c.id, c.name]))
const usedBy = catalog.templates.filter((tpl) => tpl.requires.includes(x.id))
const needs = x.requires.map((r) =>
  "component" in r
    ? {
        text: componentName.get(r.component) ?? r.component,
        href: entryUrl(locale, "components", r.component),
      }
    : { text: w.capability(r.capability) },
)
const render = await markdown
const readme = await Promise.all(
  x.readme[locale].map(async (s) => ({ ...s, html: (await render.render(s.markdown)).code })),
)
// Used by follows Use it: setup and use first, then what depends on it, then removal.
const split = readme.findIndex((s) => s.id === "remove-it" || s.id === "troubleshooting")
const [before, after] = split < 0 ? [readme, []] : [readme.slice(0, split), readme.slice(split)]
const agentDocs = siteOrigin + markdownPath(docsUrl(locale, "zeabur", "cluster/components"))
---

<EntryPage
  locale={locale}
  kind="components"
  entry={x}
  title={w.pageTitle(x.name)}
  facts={[{ label: t.facts.capability, value: x.capability }]}
  glance={[
    {
      label: w.defaults.title,
      value: w.defaults.value(x.defaults.singleNode, x.defaults.multiNode),
    },
  ]}
  actions={[
    { href: docsUrl(locale, "zeabur", "cluster/components"), text: w.install, icon: "arrow-right" },
    { href: x.homepage, text: t.about(x.name), icon: "arrow-up-right" },
  ]}
>
  {before.map((r) => (
    <Section id={r.id} title={r.title}>
      <div class="prose min-w-0" set:html={r.html} />
    </Section>
  ))}

  <Section id="agent" title={t.agent.title} body={t.agent.body}>
    <CommandBlock
      id="agent-prompt"
      code={t.agent.components(x.id, agentDocs)}
      copy={t.agent.copy}
      wrap
    />
  </Section>

  {usedBy.length > 0 && (
    <Section id="used-by" title={w.usedBy}>
      <Pills
        items={usedBy.map((tpl) => ({
          text: tpl.name,
          href: entryUrl(locale, "templates", tpl.id),
        }))}
      />
    </Section>
  )}

  {after.map((r) => (
    <Section id={r.id} title={r.title}>
      <div class="prose min-w-0" set:html={r.html} />
    </Section>
  ))}

  <Section slot="details" id="security" title={t.security}>
    <p class="body" lang="en">
      {x.security}
    </p>
  </Section>

  <Section slot="details" id="releases" title={w.releases}>
    <Pills
      items={x.releases.map((r) => ({
        text: r.version ? `${r.name} ${r.version}` : r.name,
        mono: true,
      }))}
    />
    {needs.length > 0 && (
      <div class="grid gap-3">
        <h3 class="label text-site-faint">{w.needs}</h3>
        <Pills items={needs} />
      </div>
    )}
    {usedBy.length > 0 && (
      <div class="grid gap-3">
        <h3 class="label text-site-faint">{w.usedBy}</h3>
        <Pills
          items={usedBy.map((tpl) => ({
            text: tpl.name,
            href: entryUrl(locale, "templates", tpl.id),
          }))}
        />
      </div>
    )}
  </Section>
</EntryPage>
