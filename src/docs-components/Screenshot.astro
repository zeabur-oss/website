---
import type { z } from "zod"
import { screenshotHtml } from "../lib/shots.ts"
import type { registry } from "./registry.ts"

type Props = z.infer<(typeof registry)["Screenshot"]>
const { repo, contentLocale } = Astro.locals.starlightRoute.entry.data
---

<Fragment set:html={screenshotHtml(Astro.props, { repo, contentLocale })} />
