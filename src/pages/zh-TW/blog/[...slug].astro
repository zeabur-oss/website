---
import BlogPost from "../../../blog/BlogPost.astro"
import { postSlug, postsFor, type Post } from "../../../blog/blog.ts"

export async function getStaticPaths() {
  return (await postsFor("zh-TW")).map((post) => ({
    params: { slug: postSlug(post.id) },
    props: { post },
  }))
}
const { post } = Astro.props as { post: Post }
---

<BlogPost post={post} />
