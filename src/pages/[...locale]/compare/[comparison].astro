---
import ComparisonPage from "../../../compare/ComparisonPage.astro"
import { comparisonSlug } from "../../../compare/data.ts"
import { publishedComparisons } from "../../../compare/published.ts"
import { localePaths } from "../../../lib/urls.ts"

export function getStaticPaths() {
  return localePaths().flatMap(({ params, props }) =>
    publishedComparisons.map((id) => ({
      params: { ...params, comparison: comparisonSlug(id) },
      props: { ...props, id },
    })),
  )
}
const { locale, id } = Astro.props
---

<ComparisonPage locale={locale} id={id} />
