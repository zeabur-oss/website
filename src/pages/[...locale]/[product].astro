---
import { getCollection } from "astro:content"
import ProductPage from "../../landing/ProductPage.astro"
import { pageSlugs } from "../../lib/site-pages.ts"
import { localePaths } from "../../lib/urls.ts"

export async function getStaticPaths() {
  for (const { id } of await getCollection("pages")) {
    const slug = id.slice(id.indexOf("/") + 1)
    if (!pageSlugs.includes(slug))
      throw new Error(`src/content/pages/${id}.yaml has no row in site-pages.ts`)
  }
  return localePaths().flatMap(({ params, props }) =>
    pageSlugs.map((product) => ({ params: { ...params, product }, props: { ...props, product } })),
  )
}
const { locale, product } = Astro.props
---

<ProductPage locale={locale} slug={product} />
