---
import { getCollection } from "astro:content"
import ProductPage from "../../landing/ProductPage.astro"
import { localePaths } from "../../lib/urls.ts"

export async function getStaticPaths() {
  const pages = await getCollection("pages")
  return localePaths().flatMap(({ params, props }) =>
    pages
      .filter((page) => page.id.startsWith(`${props.locale}/`))
      .map((page) => {
        const product = page.id.slice(props.locale.length + 1)
        return { params: { ...params, product }, props: { ...props, product } }
      }),
  )
}
const { locale, product } = Astro.props
---

<ProductPage locale={locale} slug={product} />
