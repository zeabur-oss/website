---
// The one command that opens Zeabur with the reader's own kubeconfig.
import Icon from "../components/Icon.astro"
import { docsUrl, type SiteLocale } from "../lib/urls.ts"
import Beat from "./Beat.astro"
import { homeCopy } from "./copy/index.ts"
import Rich from "./Rich.astro"

interface Props {
  locale: SiteLocale
  index: number
  of: number
}
const { locale, index, of } = Astro.props
const t = homeCopy[locale].local
---

<section class="band-ink" id="local" aria-labelledby="local-title">
  <div class="wrap">
    <Beat index={index} of={of} />
    <div class="grid12 items-end gap-y-8">
      <pre class="local-code lg:col-[1/8]" data-reveal><code>zeaburctl ui</code></pre>
      <div class="lg:col-[8/13]" data-reveal style="--i:1">
        <h2 id="local-title" class="sub-title">
          <a href={docsUrl(locale, "zeabur", "reference/zeaburctl")} class="title-link">
            {t.title}
            <Icon name="arrow-right" class="go" />
          </a>
        </h2>
        <p class="body mt-3">
          <Rich text={t.body} />
        </p>
      </div>
    </div>
  </div>
</section>
