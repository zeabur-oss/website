---
// What the next release brings. Nothing here is out yet.
import type { SiteLocale } from "../lib/urls.ts"
import Band from "./Band.astro"
import { homeCopy } from "./copy/index.ts"
import Rich from "./Rich.astro"

interface Props {
  locale: SiteLocale
  index: number
  of: number
}
const { locale, index, of } = Astro.props
---

<section class="wrap band" id="soon" aria-labelledby="soon-title">
  <Band id="soon-title" index={index} of={of} title="Coming soon" />
  <ul class="cells cells-2 upcoming">
    {homeCopy[locale].soon.map((line, i) => (
      <li data-reveal style={`--i:${i}`}>
        <p class="body">
          <Rich text={line} />
        </p>
      </li>
    ))}
  </ul>
</section>
