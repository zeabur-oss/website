---
import Beat from "./Beat.astro"

// A numbered part of the home page: its number on a rule, then the title and one paragraph.
interface Props {
  id: string
  index: number
  of: number
  title: string
  lead?: string
}
const { id, index, of, title, lead } = Astro.props
---

<header class="band-head" data-reveal>
  <Beat index={index} of={of} />
  <h2 id={id}>{title}</h2>
  {lead && <p class="lead">{lead}</p>}
</header>
