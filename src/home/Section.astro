---
// A part of the home page: a title, one paragraph, then its content.
import Rich from "./Rich.astro"

interface Props {
  id: string
  title: string
  lead?: string
}
const { id, title, lead } = Astro.props
---

<section class="wrap part" id={id} aria-labelledby={`${id}-title`}>
  <header class="part-head" data-reveal>
    <h2 id={`${id}-title`}>{title}</h2>
    {lead && (
      <p class="lead">
        <Rich text={lead} />
      </p>
    )}
  </header>
  <slot />
</section>
