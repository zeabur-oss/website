---
// Moving from Dokploy: what becomes something else, and what is the same on both sides. From the
// two products' rows of the comparison matrix.
const changes = [
  ["Docker + Traefik", "Kubernetes"],
  ["Swarm", "K3s · RKE2"],
  ["Redis", "Dragonfly"],
]
const stays = ["Git", "PostgreSQL", "MySQL", "MariaDB", "MongoDB", "S3"]
---

<div class="fx-moving">
  <div class="fx-moving-names" aria-hidden="true">
    <span>Dokploy</span>
    <span>Zeabur</span>
  </div>
  {changes.map(([from, to], k) => (
    <div class="fx-lane">
      <span class="node">{from}</span>
      <span class="wire">
        <i class="fx" style={`--fx:fx-draw;--s:${k * 2}`} />
      </span>
      <span class="node ok fx" style={`--s:${k * 2 + 1}`}>
        {to}
      </span>
    </div>
  ))}
  <div class="fx-lane">
    <span class="chips">
      {stays.map((name) => (
        <span class="chip">{name}</span>
      ))}
    </span>
    <span class="wire">
      <i class="fx" style={`--fx:fx-draw;--s:${changes.length * 2}`} />
    </span>
    <span class="chips fx" style={`--s:${changes.length * 2 + 1}`}>
      {stays.map((name) => (
        <span class="chip">{name}</span>
      ))}
    </span>
  </div>
</div>
