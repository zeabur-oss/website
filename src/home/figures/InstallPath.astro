---
// The next release's way from one Linux server to Zeabur: Zeatend sets up the cluster and hands
// over a kubeconfig.
const stops = ["Linux", "Zeatend", "K3s · RKE2 · KubeSolo", "kubeconfig", "Zeabur"]
---

<div class="fx-path">
  {stops.map((stop, k) => (
    <>
      {k > 0 && (
        <span class="wire">
          <i class="fx" style={`--fx:fx-draw;--s:${k * 2 - 1}`} />
        </span>
      )}
      <span class:list={["node fx", k === stops.length - 1 && "ok"]} style={`--s:${k * 2}`}>
        {stop}
      </span>
    </>
  ))}
</div>
