---
// Everything under the first screen: the same page for both readers, put together from blocks.
import Comparison from "../blocks/Comparison.astro"
import Cta from "../blocks/Cta.astro"
import Proof from "../blocks/Proof.astro"
import Rich from "../blocks/Rich.astro"
import Section from "../blocks/Section.astro"
import Split from "../blocks/Split.astro"
import Steps from "../blocks/Steps.astro"
import Visual from "../blocks/Visual.astro"
import Icon from "../components/Icon.astro"
import { githubStars, shortCount } from "../lib/github.ts"
import { githubOrg } from "../lib/site.ts"
import { docsUrl, type SiteLocale } from "../lib/urls.ts"
import { homeCopy } from "./copy/index.ts"
import Access from "./figures/Access.astro"
import Diff from "./figures/Diff.astro"
import InstallPath from "./figures/InstallPath.astro"
import LocalMode from "./figures/LocalMode.astro"
import ObjectsStay from "./figures/ObjectsStay.astro"
import Trace from "./figures/Trace.astro"

interface Props {
  locale: SiteLocale
}
const { locale } = Astro.props
const t = homeCopy[locale]
const docs = (slug?: string) => docsUrl(locale, "zeabur", slug)
const stars = await githubStars()
const [find, see, read] = t.walk.steps
---

<Section id="walk" title={t.walk.title} lead={t.walk.intro}>
  <Steps steps={t.walk.steps}>
    <Visual slot="visual-0" label={find!.title}>
      <Trace step={0} />
    </Visual>
    <Visual slot="visual-1" label={see!.title} after={5}>
      <Trace step={1} />
    </Visual>
    <Visual slot="visual-2" label={read!.title} after={11}>
      <Trace step={2} />
    </Visual>
  </Steps>
</Section>

<Section id="permissions" title={t.perm.title} lead={t.perm.body}>
  <Comparison a={t.perm.erin} b={t.perm.alice}>
    <Visual slot="a" label={t.perm.erin}>
      <Access who="erin" request="patch deployments" allowed />
    </Visual>
    <Visual slot="b" label={t.perm.alice} after={3}>
      <Access who="alice" request="get pods/log" allowed={false} />
    </Visual>
  </Comparison>
  <p class="note" data-reveal>
    {t.perm.invite}
    {t.perm.scope}
  </p>
</Section>

<Section id="review">
  <Split>
    <h2>{t.review.title}</h2>
    <div class="rows">
      <p class="body">{t.review.body}</p>
      <p class="body">{t.review.conflict}</p>
      <p class="body">{t.review.gitops}</p>
    </div>
    <Visual slot="visual" label={t.review.title}>
      <Diff />
    </Visual>
  </Split>
</Section>

<Section id="local" title={t.local.title} lead={t.local.body}>
  <Visual label={t.local.title} class="visual-wide">
    <LocalMode />
  </Visual>
</Section>

<Section id="leave" title={t.lockin.title} lead={t.lockin.body}>
  <Visual label={t.lockin.title} class="visual-wide">
    <ObjectsStay />
  </Visual>
  <p class="note" data-reveal>
    {t.lockin.gitops} {t.lockin.existing}
  </p>
  <div id="security">
    <Proof
      claims={[
        {
          title: t.lockin.uninstall.title,
          body: t.lockin.uninstall.after,
          link: { text: t.lockin.uninstall.link, href: docs("leave/uninstall") },
        },
        t.license,
        {
          title: t.safety.title,
          body: `${t.safety.hardening} ${t.safety.gitops}`,
          link: {
            text: t.safety.hardeningLink,
            href: "https://docs.k3s.io/security/hardening-guide",
          },
        },
      ]}
    />
  </div>
</Section>

<Section id="soon" title="Coming soon">
  <Visual label="Linux, Zeatend, K3s · RKE2 · KubeSolo, kubeconfig, Zeabur" class="visual-wide">
    <InstallPath />
  </Visual>
  <ul class="upcoming">
    {t.soon.map((line, i) => (
      <li data-reveal style={`--i:${i}`}>
        <p class="body">
          <Rich text={line} />
        </p>
      </li>
    ))}
  </ul>
</Section>

<Cta id="start" title={t.cta.title} lead={t.cta.body}>
  <a href={docs("reference/zeaburctl")} class="button primary">
    {t.cta.primary}
    <Icon name="arrow-right" class="go" />
  </a>
  <a href={docs()} class="button">
    {t.cta.secondary}
  </a>
  <a href={`${githubOrg}/zeabur`} class="button">
    <Icon name="github-logo" />
    GitHub
    {stars !== undefined && (
      <span class="inline-flex items-center gap-1 font-mono text-[0.75rem] text-site-faint">
        <Icon name="star" weight="fill" class="!size-3" />
        {shortCount(stars, locale)}
      </span>
    )}
  </a>
</Cta>
