---
// Two people in one project, and the review before a change is written.
import { shot, sizes } from "../landing/shots.ts"
import type { SiteLocale } from "../lib/urls.ts"
import Band from "./Band.astro"
import { homeCopy } from "./copy/index.ts"
import Frame from "../landing/Frame.astro"
import Pending from "./Pending.astro"

interface Props {
  locale: SiteLocale
  index: number
  of: number
}
const { locale, index, of } = Astro.props
const copy = homeCopy[locale]
const t = copy.perm
const review = copy.review
const people = [
  { name: "erin", can: t.erin },
  { name: "alice", can: t.alice },
]
---

<section class="wrap band" id="permissions" aria-labelledby="permissions-title">
  <Band id="permissions-title" index={index} of={of} title={t.title} lead={t.body} />

  <div class="grid12 items-start">
    <div class="lg:col-[1/7]" data-reveal>
      <ul class="people">
        {people.map(({ name, can }) => (
          <li>
            <p class="person">
              {name}
              <span>@shop</span>
            </p>
            <p class="body">{can}</p>
          </li>
        ))}
      </ul>
      <div class="mt-6">
        <Pending file="service-logs-forbidden.avif" ratio="1264 / 560" />
      </div>
    </div>
    <figure class="lg:col-[7/13]" data-reveal style="--i:1">
      <Frame src={shot(locale, "members-invite")} alt={copy.alt.invite} sizes={sizes.half} />
      <figcaption class="note">
        {t.invite}
        <span class="note-limit">{t.scope}</span>
      </figcaption>
    </figure>
  </div>

  <div class="grid12 mt-14 items-start md:mt-24" id="review">
    <div class="lg:col-[1/6]" data-reveal>
      <h3 class="sub-title">{review.title}</h3>
      <p class="body mt-3">{review.body}</p>
      <ol class="plan">
        <li>
          <p class="body">{review.conflict}</p>
        </li>
        <li>
          <p class="body">{review.gitops}</p>
        </li>
      </ol>
    </div>
    <div class="lg:col-[7/13]" data-reveal style="--i:1">
      <Frame src={shot(locale, "change-review")} alt={review.title} sizes={sizes.half} />
    </div>
  </div>
</section>
