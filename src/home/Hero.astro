---
// The first screen. A switch picks the reader: a team that shares a cluster, or one machine.
// Without scripts both sides show, one under the other, and the switch links to each.
import { cn } from "cn"
import Icon from "../components/Icon.astro"
import Frame from "../landing/Frame.astro"
import { landingCopy } from "../landing/copy.ts"
import { shot, sizes } from "../landing/shots.ts"
import { docsUrl, type SiteLocale } from "../lib/urls.ts"
import { homeCopy } from "./copy/index.ts"
import Proof from "../blocks/Proof.astro"
import Rich from "../blocks/Rich.astro"

interface Props {
  locale: SiteLocale
}
const { locale } = Astro.props
const copy = homeCopy[locale]
const docs = (slug: string) => docsUrl(locale, "zeabur", slug)
// A number stays on the line of its unit.
const unbroken = (text: string) => text.replace(/(\d) (?=(?:GiB|MiB|vCPU)\b)/g, "$1 ")
const sides = [
  {
    id: "team",
    text: copy.hero.team,
    note: copy.hero.team.soon,
    soon: false,
    primary: docs("install/existing-cluster"),
    secondary: "#permissions",
  },
  {
    id: "personal",
    text: copy.hero.machine,
    note: copy.hero.machine.next,
    soon: true,
    primary: docs("get-started/quickstart"),
    secondary: docs("install/personal"),
  },
] as const
---

<section class="wrap hero-switch">
  <script is:inline>
    document.documentElement.dataset.audience = location.hash === "#personal" ? "personal" : "team"
  </script>
  <div class="switch" data-switch>
    {sides.map(({ id, text, soon }) => (
      <a href={`#${id}`} id={`tab-${id}`} data-tab={id}>
        {text.eyebrow}
        {soon && <span class="soon">Coming soon</span>}
      </a>
    ))}
  </div>

  <div class="panels">
    {sides.map(({ id, text, note, soon, primary, secondary }) => {
      const Title = id === "team" ? "h1" : "h2"
      return (
        <div class="panel" id={id} data-panel>
          <Title class="display">{unbroken(text.title)}</Title>
          <p class="lead">
            <Rich text={text.sub} />
          </p>
          <div class="hero-actions">
            <a href={primary} class="button primary">
              {text.primary}
              <Icon name="arrow-right" class="go" />
            </a>
            <a href={secondary} class={cn("more", id === "team" && "more-down")}>
              {text.secondary}
              <Icon name={id === "team" ? "arrow-down" : "arrow-right"} class="go" />
            </a>
          </div>
          <p class="hero-note">
            {!soon && <span class="soon">Coming soon</span>}
            <Rich text={note} />
          </p>
        </div>
      )
    })}
  </div>

  <div class="hero-shot" data-reveal>
    <Frame
      src={shot(locale, "project")}
      alt={landingCopy[locale].shots.project}
      sizes={sizes.full}
      ratio="1240 / 640"
      eager
    />
  </div>

  <Proof claims={copy.proof} />
</section>

<script>
  // The switch as tabs: one side shown, the choice kept in the address as #team or #personal.
  type Audience = "team" | "personal"
  const audienceOf = (hash: string): Audience => (hash === "#personal" ? "personal" : "team")

  function show(audience: Audience) {
    document.documentElement.dataset.audience = audience
    for (const tab of document.querySelectorAll<HTMLElement>("[data-tab]")) {
      const on = tab.dataset.tab === audience
      tab.setAttribute("aria-selected", String(on))
      tab.tabIndex = on ? 0 : -1
    }
  }

  function setUp() {
    const bar = document.querySelector<HTMLElement>("[data-switch]")
    if (!bar) return
    bar.setAttribute("role", "tablist")
    const tabs = [...bar.querySelectorAll<HTMLElement>("[data-tab]")]
    for (const tab of tabs) {
      tab.setAttribute("role", "tab")
      tab.setAttribute("aria-controls", tab.dataset.tab!)
    }
    for (const panel of document.querySelectorAll<HTMLElement>("[data-panel]")) {
      panel.setAttribute("role", "tabpanel")
      panel.setAttribute("aria-labelledby", `tab-${panel.id}`)
    }
    const choose = (tab: HTMLElement) => {
      const audience = tab.dataset.tab as Audience
      show(audience)
      history.replaceState(history.state, "", `#${audience}`)
    }
    bar.addEventListener("click", (event) => {
      const tab = (event.target as Element).closest<HTMLElement>("[data-tab]")
      if (!tab) return
      event.preventDefault()
      choose(tab)
    })
    bar.addEventListener("keydown", (event) => {
      const at = tabs.indexOf(document.activeElement as HTMLElement)
      const step = { ArrowRight: 1, ArrowLeft: -1 }[event.key]
      if (at < 0 || step === undefined) return
      event.preventDefault()
      const next = tabs[(at + step + tabs.length) % tabs.length]!
      next.focus()
      choose(next)
    })
    show(audienceOf(location.hash))
  }

  document.addEventListener("astro:before-swap", (event) => {
    event.newDocument.documentElement.dataset.audience = audienceOf(event.to.hash)
  })
  document.addEventListener("astro:page-load", setUp)
  window.addEventListener("hashchange", () => {
    if (location.hash === "#team" || location.hash === "#personal") show(audienceOf(location.hash))
  })
</script>
