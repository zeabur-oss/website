---
// Keeps each Chinese word on one line; <wbr> lets Safari break between words.
import { chineseTextSegments } from "./chinese-text.ts"

interface Props {
  text: string
  locale: string
}
const { text, locale } = Astro.props
const plain = locale === "en" || !/\p{Script=Han}/u.test(text)
---

{plain
  ? text
  : chineseTextSegments(text, locale).map((word, i) =>
      word.trim() ? (
        <Fragment>
          {i > 0 && <wbr />}
          <span class="zh-word">{word}</span>
        </Fragment>
      ) : (
        word
      ),
    )}
