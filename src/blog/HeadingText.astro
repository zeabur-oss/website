---
// Breaks Chinese only between words: keep-all holds each word together, <wbr> marks the gaps,
// and text-wrap picks among them.
import { chineseTextSegments } from "./chinese-text.ts"

interface Props {
  text: string
  locale: string
}
const { text, locale } = Astro.props
const plain = locale === "en" || !/\p{Script=Han}/u.test(text)
---

{plain ? (
  text
) : (
  <span class="zh-words">
    {chineseTextSegments(text, locale).map((word, i) => (
      <Fragment>
        {i > 0 && word.trim() && <wbr />}
        {word}
      </Fragment>
    ))}
  </span>
)}
