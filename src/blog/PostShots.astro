---
// Screenshots in a post, from public/blog/<slug>/. `<name>-dark.avif` beside an image is its dark
// theme.
import { existsSync } from "node:fs"
import Shot from "../landing/Shot.astro"

interface Props {
  shots: { src: string; alt: string }[]
}
const sizes = "(min-width: 768px) 704px, calc(100vw - 32px)"
const dark = (src: string) => {
  const path = src.replace(/\.avif$/, "-dark.avif")
  return existsSync(`public${path}`) ? path : src
}
---

<div class="post-shots">
  {Astro.props.shots.map(({ src, alt }) => (
    <Shot light={src} dark={dark(src)} alt={alt} sizes={sizes} />
  ))}
</div>
