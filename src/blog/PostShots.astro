---
// Screenshots of the Zeabur web app in a post, from the site shots (src/landing/shots.ts).
import Shot from "../landing/Shot.astro"
import { siteShot } from "../landing/shots.ts"

interface Props {
  locale: string
  shots: { id: string; alt: string }[]
}
const { locale, shots } = Astro.props
const sizes = "(min-width: 768px) 704px, calc(100vw - 32px)"
---

<div class="post-shots">
  {shots.map(({ id, alt }) => (
    <Shot {...siteShot(locale, id)} alt={alt} sizes={sizes} />
  ))}
</div>
