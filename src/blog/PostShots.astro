---
// Screenshots in a post: the site shots by default, or Zeabur's docs shots and Identity's sign-in
// pages (src/landing/shots.ts).
import Shot from "../landing/Shot.astro"
import { docsShot, identityShot, siteShot } from "../landing/shots.ts"

interface Props {
  locale: string
  shots: { id: string; alt: string; from?: "site" | "docs" | "identity" }[]
}
const { locale, shots } = Astro.props
const sizes = "(min-width: 768px) 704px, calc(100vw - 32px)"
const source = ({ id, from }: Props["shots"][number]) =>
  from === "docs"
    ? docsShot(locale, id)
    : from === "identity"
      ? identityShot(id)
      : siteShot(locale, id)
---

<div class="post-shots">
  {shots.map((shot) => {
    const src = source(shot)
    return src && <Shot {...src} alt={shot.alt} sizes={sizes} />
  })}
</div>
