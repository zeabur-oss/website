---
import { iconDataUri } from "../lib/icons.ts"

interface Props {
  word: string
  id: string
}
const { word, id } = Astro.props
const caret = iconDataUri("caret-circle-down")
---

<label class="term-word cursor-pointer whitespace-nowrap text-site-accent has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-3 has-[:focus-visible]:outline-site-accent print:text-inherit">
  {word}
  <input
    type="checkbox"
    id={id}
    aria-controls={`${id}-note`}
    class="term-toggle m-0 ml-[0.12em] inline-block size-[1.05em] cursor-pointer appearance-none border-0 bg-current p-0 align-[-0.15em] mask-contain mask-center mask-no-repeat [mask-image:var(--term-icon)] checked:rotate-180 motion-safe:transition-transform motion-safe:duration-200 forced-colors:appearance-auto forced-colors:bg-transparent forced-colors:[mask-image:none] forced-colors:checked:rotate-0 print:hidden"
    style={{ "--term-icon": caret }}
  />
</label>
