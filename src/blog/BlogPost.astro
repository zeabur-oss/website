---
import { getCollection, render } from "astro:content"
import Icon from "../components/Icon.astro"
import Site from "../layouts/Site.astro"
import { blogPath, dateFormat, postLocale, postSlug, postsFor, postUrl, type Post } from "./blog.ts"
import { blogCopy } from "./copy.ts"
import { organization } from "../lib/seo.ts"
import { locales, siteOrigin } from "../lib/urls.ts"
import HeadingText from "./HeadingText.astro"

// The reading layout, after engawa's landing (src/components/BlogPost.astro, Apache-2.0): title,
// description and dates, the text in one 44rem column with its contents beside it, then the
// other posts. Prints without the site around it.
interface Props {
  post: Post
}
const { post } = Astro.props
const locale = postLocale(post.id)
const t = blogCopy[locale]
const { Content, headings } = await render(post)
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3)
const others = (await postsFor(locale)).filter((p) => p.id !== post.id).slice(0, 4)
const date = dateFormat(locale, "long")
const { title, description, pubDate, updatedDate, draft } = post.data
const slug = postSlug(post.id)
const same = new Set((await getCollection("blog")).map((p) => p.id))
const languages = locales.filter((l) => same.has(`${l}/${slug}`))
// A language without this post switches to that language's blog.
const alternates = Object.fromEntries(
  locales.filter((l) => !languages.includes(l)).map((l) => [l, blogPath(l)]),
)
const image = `/og/blog/${locale}/${slug}.png`
---

<Site
  locale={locale}
  title={`${title} · Zeabur Open Source`}
  description={description}
  section="blog"
  type="article"
  image={image}
  languages={languages}
  alternates={alternates}
  schema={{
    "@type": "BlogPosting",
    headline: title,
    description,
    datePublished: pubDate.toISOString(),
    dateModified: (updatedDate ?? pubDate).toISOString(),
    image: `${siteOrigin}${image}`,
    author: organization,
    publisher: organization,
  }}
>
  <header class="wrap hero post-head stagger">
    <a class="back" href={blogPath(locale)}>
      <Icon name="arrow-left" />
      {t.back}
    </a>
    <h1 class="display">
      <HeadingText text={title} locale={locale} />
    </h1>
    <p class="lead">
      <HeadingText text={description} locale={locale} />
    </p>
    <p class="meta">
      <span>
        {t.published} <time datetime={pubDate.toISOString()}>{date.format(pubDate)}</time>
      </span>
      {updatedDate && (
        <span>
          {t.updated} <time datetime={updatedDate.toISOString()}>{date.format(updatedDate)}</time>
        </span>
      )}
      {draft && <span class="pill">{t.draft}</span>}
    </p>
  </header>

  <article class="wrap section article">
    <div class="prose">
      <Content />
    </div>
    {toc.length > 1 && (
      <nav class="toc" aria-label={t.toc} data-toc>
        <p class="toc-title">{t.toc}</p>
        <ol>
          {toc.map((h) => (
            <li class={`toc-d${h.depth}`}>
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))}
        </ol>
      </nav>
    )}
  </article>

  {others.length > 0 && (
    <section class="wrap section more-posts" aria-labelledby="more-posts">
      <h2 id="more-posts" class="more-title">
        {t.more}
      </h2>
      <ul>
        {others.map((p) => (
          <li>
            <a href={postUrl(p)}>
              <span class="more-name">
                <HeadingText text={p.data.title} locale={locale} />
              </span>
              <span class="body">{p.data.description}</span>
            </a>
          </li>
        ))}
      </ul>
      <a class="more" href={`${blogPath(locale)}/rss.xml`}>
        <Icon name="rss" />
        {t.rss}
      </a>
    </section>
  )}
</Site>

<style>
  .post-head {
    display: grid;
    justify-items: start;
    gap: 1.25rem;
    padding-bottom: 0;
  }
  .post-head .display {
    max-width: 18em;
    font-size: clamp(2rem, 1.6rem + 1.8vw, 3.25rem);
  }
  .post-head .lead {
    max-width: 40rem;
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.875rem;
    color: var(--site-muted);
    text-decoration: none;
  }
  .back:hover {
    color: var(--site-text);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 1.5rem;
    font-size: 0.8125rem;
    color: var(--site-faint);
  }

  .article {
    display: grid;
    gap: 3rem;
    align-items: start;
  }
  .article::before {
    grid-column: 1 / -1;
    margin-top: 2.5rem;
    margin-bottom: 0.5rem;
  }
  @media (min-width: 1100px) {
    .article {
      grid-template-columns: minmax(0, 44rem) minmax(0, 1fr);
    }
  }

  .toc {
    position: sticky;
    top: calc(var(--header-height) + 2rem);
    justify-self: end;
    width: min(100%, 16rem);
    max-height: calc(100vh - var(--header-height) - 4rem);
    overflow-y: auto;
  }
  @media (max-width: 1099px) {
    .toc {
      display: none;
    }
  }
  .toc-title {
    margin-bottom: 0.75rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--site-muted);
  }
  .toc ol {
    display: grid;
    gap: 0.125rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .toc a {
    display: block;
    padding-block: 0.3125rem;
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--site-faint);
    text-decoration: none;
    transition: color var(--transition-duration-quick) var(--ease-site);
  }
  .toc-d3 a {
    padding-left: 0.75rem;
  }
  .toc a:hover {
    color: var(--site-text);
  }
  .toc a[aria-current="true"] {
    color: var(--site-text);
    font-weight: 500;
  }

  .prose {
    max-width: 44rem;
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--site-text);
  }
  :lang(zh) .prose {
    line-height: 1.85;
  }
  .prose :global(> * + *) {
    margin-top: 1.1em;
  }
  .prose :global(:is(h2, h3)) {
    scroll-margin-top: calc(var(--header-height) + 2rem);
    font-weight: 600;
    text-wrap: balance;
  }
  .prose :global(h2) {
    margin-top: 2.2em;
    font-size: clamp(1.5rem, 1.35rem + 0.6vw, 1.875rem);
    line-height: 1.25;
  }
  .prose :global(h3) {
    margin-top: 1.8em;
    font-size: 1.25rem;
  }
  .prose :global(a) {
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--site-accent) 55%, transparent);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 3px;
  }
  .prose :global(a:hover) {
    color: var(--site-accent);
    text-decoration-color: currentColor;
  }
  .prose :global(:is(ul, ol)) {
    padding-left: 1.3em;
  }
  .prose :global(ul) {
    list-style: disc;
  }
  .prose :global(ol) {
    list-style: decimal;
  }
  .prose :global(li + li) {
    margin-top: 0.4em;
  }
  .prose :global(blockquote) {
    margin-inline: 1.5rem 0;
    color: var(--site-muted);
  }
  .prose :global(:not(pre) > code) {
    padding: 0.1em 0.35em;
    border: 1px solid var(--site-line);
    border-radius: var(--radius-sm);
    font-size: 0.86em;
    overflow-wrap: anywhere;
  }
  .prose :global(pre) {
    padding: 1rem 1.25rem;
    border: 1px solid var(--site-line);
    border-radius: var(--radius-lg);
    font-size: 0.84375rem;
    line-height: 1.7;
    overflow-x: auto;
  }
  .prose :global(img) {
    height: auto;
    border: 1px solid var(--site-line);
    border-radius: var(--radius-lg);
  }
  .prose :global(:is(.post-shots, .post-figure)) {
    margin-block: 2em;
  }
  .prose :global(.post-shots) {
    display: grid;
    gap: 1rem;
  }
  .prose :global(.shot img) {
    border: 0;
    border-radius: 0;
  }
  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }
  .prose :global(:is(th, td)) {
    padding: 0.625rem 0.875rem 0.625rem 0;
    border-bottom: 1px solid var(--site-line);
    text-align: left;
    vertical-align: top;
  }
  .prose :global(hr) {
    border: 0;
    border-top: 1px solid var(--site-line);
  }

  .more-posts {
    display: grid;
    justify-items: start;
    gap: 1.5rem;
  }
  .more-title {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--site-muted);
  }
  .more-posts ul {
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--site-line);
  }
  .more-posts li a {
    display: grid;
    gap: 0.375rem;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--site-line);
    color: inherit;
    text-decoration: none;
  }
  .more-name {
    font-size: 1.25rem;
    font-weight: 600;
  }
  .more-posts li a:hover .more-name {
    color: var(--site-accent);
  }

  @media print {
    @page {
      size: A4;
      margin: 20mm 22mm 22mm;
    }
    /* Paper is light whichever theme is on screen; the tokens follow color-scheme. */
    :global(:root),
    :global(:root[data-theme="dark"]) {
      color-scheme: light;
      background: #fff;
    }
    :global(:root[data-theme="dark"] .theme-light) {
      display: block;
    }
    :global(:root[data-theme="dark"] .theme-dark) {
      display: none;
    }
    :global(.site-header),
    :global(.site-footer),
    .back,
    .toc,
    .more-posts {
      display: none !important;
    }
    :global(body) {
      background: #fff;
      color: #111;
    }
    .post-head,
    .article {
      max-width: none;
      padding: 0;
    }
    .post-head {
      gap: 3mm;
      margin-bottom: 8mm;
      padding-bottom: 5mm;
      border-bottom: 0.5pt solid #ccc;
    }
    .post-head > :global(*) {
      opacity: 1 !important;
      translate: none !important;
      filter: none !important;
    }
    .post-head .display {
      max-width: none;
      font-size: 20pt;
      line-height: 1.35;
    }
    .post-head .lead {
      max-width: none;
      font-size: 11pt;
      line-height: 1.7;
      color: #444;
    }
    .meta {
      font-size: 8.5pt;
      color: #666;
    }
    .article::before {
      display: none;
    }
    .prose {
      max-width: none;
      font-size: 10.5pt;
      line-height: 1.8;
      color: #111;
      orphans: 2;
      widows: 2;
    }
    .prose :global(> * + *) {
      margin-top: 0.9em;
    }
    .prose :global(h2) {
      margin-top: 1.8em;
      font-size: 14pt;
      line-height: 1.4;
    }
    .prose :global(:is(h2, h3)) {
      break-after: avoid;
    }
    .prose :global(a) {
      color: inherit;
      text-decoration-color: #999;
      text-decoration-thickness: 0.5pt;
    }
    .prose :global(:is(.post-shots, .post-figure, .shot, img, figure)) {
      break-inside: avoid;
    }
    .prose :global(:is(.post-shots, .post-figure)) {
      margin-block: 1.4em;
    }
    .prose :global(pre) {
      white-space: pre-wrap;
      break-inside: avoid;
    }
  }
</style>

<script>
  // The contents entry for the section being read: the last heading above the line under the header.
  function track() {
    const toc = document.querySelector<HTMLElement>("[data-toc]")
    if (!toc) return
    const links = [...toc.querySelectorAll<HTMLAnchorElement>("a")]
    const targets = links
      .map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))))
      .filter((el): el is HTMLElement => el !== null)
    let queued = false
    const update = () => {
      queued = false
      let current = 0
      targets.forEach((el, i) => {
        if (el.getBoundingClientRect().top - 120 <= 0) current = i
      })
      if (innerHeight + scrollY >= document.documentElement.scrollHeight - 4)
        current = targets.length - 1
      links.forEach((a, i) => a.setAttribute("aria-current", String(i === current)))
    }
    const queue = () => {
      if (queued) return
      queued = true
      requestAnimationFrame(update)
    }
    const controller = new AbortController()
    addEventListener("scroll", queue, { passive: true, signal: controller.signal })
    addEventListener("resize", queue, { signal: controller.signal })
    document.addEventListener("astro:before-swap", () => controller.abort(), { once: true })
    update()
  }
  document.addEventListener("astro:page-load", track)
  // Lazy screenshots below the fold would otherwise print as empty frames.
  addEventListener("beforeprint", () => {
    document.querySelectorAll<HTMLImageElement>('.prose img[loading="lazy"]').forEach((img) => {
      img.loading = "eager"
    })
  })
</script>
