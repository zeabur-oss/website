---
import { getCollection, render } from "astro:content"
import "./prose.css"
import Icon from "../components/Icon.astro"
import Site from "../layouts/Site.astro"
import { dateFormat, postLocale, postSlug, postsFor, type Post } from "./blog.ts"
import { blogCopy } from "./copy.ts"
import { organization } from "../lib/seo.ts"
import { blogUrl, locales, siteOrigin } from "../lib/urls.ts"
import HeadingText from "./HeadingText.astro"
import MorePosts from "./MorePosts.astro"
import PostToc from "./PostToc.astro"

// Title, dates, the text in one 44rem column with its contents beside it, then the other posts.
interface Props {
  post: Post
}
const { post } = Astro.props
const locale = postLocale(post.id)
const t = blogCopy[locale]
const { Content, headings } = await render(post)
const others = (await postsFor(locale)).filter((p) => p.id !== post.id).slice(0, 4)
const date = dateFormat(locale, "long")
const { title, description, pubDate, updatedDate, draft } = post.data
const slug = postSlug(post.id)
const same = new Set((await getCollection("blog")).map((p) => p.id))
const languages = locales.filter((l) => same.has(`${l}/${slug}`))
// A language without this post switches to that language's blog.
const alternates = Object.fromEntries(
  locales.filter((l) => !languages.includes(l)).map((l) => [l, blogUrl(l)]),
)
const image = `/og/blog/${locale}/${slug}.png`
---

<Site
  locale={locale}
  title={`${title} · Zeabur Open Source`}
  description={description}
  section="blog"
  type="article"
  image={image}
  languages={languages}
  alternates={alternates}
  schema={{
    "@type": "BlogPosting",
    headline: title,
    description,
    datePublished: pubDate.toISOString(),
    dateModified: (updatedDate ?? pubDate).toISOString(),
    image: `${siteOrigin}${image}`,
    author: organization,
    publisher: organization,
  }}
>
  <header class="wrap hero stagger grid justify-items-start gap-5 pb-0 print:mb-[8mm] print:max-w-none print:gap-[3mm] print:border-b-[0.5pt] print:border-b-[#ccc] print:p-0 print:pb-[5mm]">
    <a
      class="inline-flex items-center gap-1.5 text-sm text-site-muted no-underline hover:text-site-text print:hidden"
      href={blogUrl(locale)}
    >
      <Icon name="arrow-left" />
      {t.back}
    </a>
    <h1 class="display max-w-[18em] text-[clamp(2rem,1.6rem+1.8vw,3.25rem)] print:max-w-none print:text-[20pt] print:leading-[1.35]">
      <HeadingText text={title} locale={locale} />
    </h1>
    <p class="lead max-w-[40rem] print:max-w-none print:text-[11pt] print:leading-[1.7] print:text-[#444]">
      <HeadingText text={description} locale={locale} />
    </p>
    <p class="flex flex-wrap items-center gap-x-6 gap-y-1 type-body text-site-faint print:text-[8.5pt] print:text-[#666]">
      <span>
        {t.published} <time datetime={pubDate.toISOString()}>{date.format(pubDate)}</time>
      </span>
      {updatedDate && (
        <span>
          {t.updated} <time datetime={updatedDate.toISOString()}>{date.format(updatedDate)}</time>
        </span>
      )}
      {draft && <span class="pill">{t.draft}</span>}
    </p>
  </header>

  <article class="wrap section grid items-start gap-12 before:col-span-full before:mt-10 before:mb-2 min-[1100px]:grid-cols-[minmax(0,44rem)_minmax(0,1fr)] print:max-w-none print:p-0 print:before:hidden">
    <div class="prose">
      <Content />
    </div>
    <PostToc headings={headings} label={t.toc} />
  </article>

  <MorePosts posts={others} locale={locale} />
</Site>

<script>
  // Lazy screenshots below the fold would otherwise print as empty frames.
  addEventListener("beforeprint", () => {
    document.querySelectorAll<HTMLImageElement>('.prose img[loading="lazy"]').forEach((img) => {
      img.loading = "eager"
    })
  })
</script>
