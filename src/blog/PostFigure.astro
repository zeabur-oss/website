---
// A diagram in a post, drawn like the product images.
import OssMap from "../components/imagery/OssMap.astro"
import { isSiteLocale } from "../lib/urls.ts"
import HotelKeycard from "./figures/HotelKeycard.astro"
import LoginFlow from "./figures/LoginFlow.astro"
import TrustStructure from "./figures/TrustStructure.astro"
import "./figures/figures.css"

interface Props {
  name: "oss-map" | "trust-structure" | "login-flow" | "hotel-keycard"
  label: string
}
const { name, label } = Astro.props
const locale = isSiteLocale(Astro.params.locale) ? Astro.params.locale : "en"
---

<figure class="post-figure">
  {name === "oss-map" && <OssMap label={label} />}
  {name === "trust-structure" && <TrustStructure label={label} locale={locale} />}
  {name === "login-flow" && <LoginFlow label={label} locale={locale} />}
  {name === "hotel-keycard" && <HotelKeycard label={label} locale={locale} />}
</figure>
