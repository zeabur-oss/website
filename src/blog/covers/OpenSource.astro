---
// The cover of the open-source launch post: the release, then the post's main idea, kubectl and
// Zeabur changing the same Deployment, then sign-in and builds. Specimens quote the product's
// own strings (zeabur web/src/i18n, identity zeabur-identity-ui).
import Logo from "../../components/Logo.astro"
import type { SiteLocale } from "../../lib/urls.ts"
import "./cover.css"

interface Props {
  locale: SiteLocale
}
type Copy = {
  hero: { big: string; small: string }
  same: { big: string; small: string; apply: string }
  signIn: { big: string; small: string; button: string; note: string }
  build: { big: string; small: string }
}

const copy: Record<SiteLocale, Copy> = {
  "zh-TW": {
    hero: {
      big: "開源",
      small: "可以自行架設的 Zeabur。管理介面、Identity、Builder 和 Catalog 一起公開。",
    },
    same: {
      big: "同一個 Deployment",
      small: "在介面改，或用 kubectl 改，改的都是叢集裡的同一份設定。",
      apply: "套用",
    },
    signIn: {
      big: "每個人用自己的帳號",
      small: "能做什麼，由 Kubernetes RBAC 決定。",
      button: "使用通行密鑰登入",
      note: "管理員權杖 5 分鐘到期",
    },
    build: { big: "從 Git 到上線", small: "每個專案有自己的建置環境和快取。" },
  },
  "zh-CN": {
    hero: {
      big: "开源",
      small: "可以自托管的 Zeabur。管理界面、Identity、Builder 和 Catalog 一起公开。",
    },
    same: {
      big: "同一个 Deployment",
      small: "在界面里改，或用 kubectl 改，改的都是集群里的同一份配置。",
      apply: "应用",
    },
    signIn: {
      big: "每个人用自己的账号",
      small: "能做什么，由 Kubernetes RBAC 决定。",
      button: "使用通行密钥登录",
      note: "管理员令牌 5 分钟后过期",
    },
    build: { big: "从 Git 到上线", small: "每个项目有自己的构建环境和缓存。" },
  },
  en: {
    hero: {
      big: "Open source",
      small: "Zeabur you host yourself. The dashboard, Identity, Builder and Catalog, all public.",
    },
    same: {
      big: "One Deployment",
      small:
        "Change it in the dashboard or with kubectl. Both edit the same object in the cluster.",
      apply: "Apply",
    },
    signIn: {
      big: "Everyone signs in as themselves",
      small: "Kubernetes RBAC decides what they can do.",
      button: "Sign in with a passkey",
      note: "Admin tokens expire in 5 minutes",
    },
    build: {
      big: "From Git to live",
      small: "Each project builds in its own space, with its own cache.",
    },
  },
}
const c = copy[Astro.props.locale]
---

<div class="cover-frame open-cover" data-reveal>
  <span class="cross cross-tl" aria-hidden="true"></span>
  <span class="cross cross-tr" aria-hidden="true"></span>
  <span class="cross cross-bl" aria-hidden="true"></span>
  <span class="cross cross-br" aria-hidden="true"></span>
  <ul class="cover-wall">
    <li class="tile tile-hero" style="grid-area: hero; --i: 0" data-area="hero">
      <Logo class="tile-logo" />
      <p class="version">v0.1.1</p>
      <p class="tile-big">{c.hero.big}</p>
      <p class="tile-small">{c.hero.small}</p>
    </li>

    <li class="tile" style="grid-area: same; --i: 1" data-area="same">
      <p class="tile-big">{c.same.big}</p>
      <p class="tile-small">{c.same.small}</p>
      <div class="same" aria-hidden="true">
        <div class="specimen sp-mono same-side">
          <span class="sp-line sp-muted">$ kubectl scale deployment web \</span>
          <span class="sp-line sp-indent sp-muted">--replicas=3</span>
          <span class="sp-line">deployment.apps/web scaled</span>
        </div>
        <span class="wire wire-in"></span>
        <div class="object">
          <span class="object-kind">Deployment</span>
          <span class="object-name">web</span>
          <span class="object-field">replicas: 3</span>
        </div>
        <span class="wire wire-out"></span>
        <div class="specimen same-side plan">
          <span class="plan-field">~ spec.replicas</span>
          <span class="plan-value">2 → 3</span>
          <span class="sp-button plan-apply">{c.same.apply}</span>
        </div>
      </div>
    </li>

    <li class="tile" style="grid-area: sign; --i: 2" data-area="sign">
      <p class="tile-big">{c.signIn.big}</p>
      <p class="tile-small">{c.signIn.small}</p>
      <div class="specimen sp-row" aria-hidden="true">
        <span class="sp-button passkey">
          <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
            <circle
              cx="6"
              cy="5"
              r="2.75"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
            ></circle>
            <path
              d="M1.5 14c0-2.5 2-4.25 4.5-4.25 1 0 1.9.25 2.6.75"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
            ></path>
            <circle
              cx="12"
              cy="9.5"
              r="1.75"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
            ></circle>
            <path
              d="M12 11.25V15m0-1.5h1.5"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
            ></path>
          </svg>
          {c.signIn.button}
        </span>
        <span class="sp-muted">{c.signIn.note}</span>
      </div>
    </li>

    <li class="tile" style="grid-area: build; --i: 3" data-area="build">
      <p class="tile-big">{c.build.big}</p>
      <p class="tile-small">{c.build.small}</p>
      <div class="specimen sp-mono" aria-hidden="true">
        <span class="sp-line sp-muted">$ git push origin main</span>
        <span class="sp-line">web:main-1761609600-4f2a9c1</span>
      </div>
    </li>
  </ul>
</div>

<style>
  .open-cover .cover-wall {
    grid-template-areas:
      "hero"
      "same"
      "sign";
  }
  .open-cover .tile[data-area="build"] {
    display: none;
  }
  @media (min-width: 720px) {
    .open-cover .cover-wall {
      grid-template-columns: minmax(0, 1.15fr) repeat(2, minmax(0, 1fr));
      grid-template-areas:
        "hero same same"
        "hero sign build";
    }
    .open-cover .tile[data-area="build"] {
      display: flex;
    }
  }

  .version {
    position: absolute;
    margin: 0;
    padding: 0.125rem 0.5rem;
    border: 1px solid var(--site-line-strong);
    border-radius: 999px;
    font-family: var(--font-stack-mono);
    font-size: 0.75rem;
    color: var(--site-muted);
  }
  .tile-hero {
    position: relative;
  }
  .tile-hero .version {
    top: 1.25rem;
    right: 1.25rem;
  }
  .tile-hero .tile-big {
    font-size: clamp(3.5rem, 1.5rem + 4.5vw, 6rem);
    text-wrap: balance;
  }

  /* kubectl on the left, the dashboard's plan on the right, both wired into one object. */
  .same {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
  }
  .same .specimen {
    margin-top: 0;
  }
  .wire {
    justify-self: center;
    width: 0;
    height: 1.25rem;
    border-left: 1.5px dashed var(--site-accent);
    transform-origin: top center;
    transition: scale 300ms var(--ease-site) 450ms;
  }
  .wire-out {
    transition-delay: 600ms;
  }
  .object {
    display: grid;
    justify-self: center;
    justify-items: center;
    gap: 0.125rem;
    padding: 0.625rem 0.875rem;
    border: 1.5px solid var(--site-accent);
    border-radius: var(--radius-md);
    background: linear-gradient(var(--site-accent-soft), var(--site-accent-soft)), var(--site-card);
    font-family: var(--font-stack-mono);
    font-size: 0.75rem;
    line-height: 1.4;
    white-space: nowrap;
  }
  .object-kind {
    color: var(--site-muted);
  }
  .object-name {
    font-size: 0.9375rem;
    font-weight: 600;
  }
  .object-field {
    color: var(--site-accent);
  }
  .plan {
    display: grid;
    grid-template-columns: auto auto;
    justify-content: start;
    align-content: center;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
    font-family: var(--font-stack-mono);
    font-size: 0.75rem;
  }
  .plan-field {
    color: var(--site-muted);
  }
  .plan-value {
    color: var(--site-accent);
    font-weight: 600;
  }
  .plan-apply {
    grid-column: 1 / -1;
    justify-self: start;
    font-family: var(--font-stack-sans);
  }
  @media (min-width: 720px) {
    .same {
      grid-template-columns: minmax(0, 1fr) 1.75rem auto 1.75rem minmax(0, 1fr);
    }
    .same-side {
      align-self: stretch;
    }
    .wire {
      width: 100%;
      height: 0;
      border-left: 0;
      border-top: 1.5px dashed var(--site-accent);
      transform-origin: left center;
    }
    .wire-out {
      transform-origin: right center;
    }
  }

  /* The sentence sits under the title; the specimen sits at the tile's foot, level with its neighbour. */
  .open-cover .tile:not(.tile-hero) .tile-small {
    margin-bottom: 0.875rem;
  }
  .open-cover .tile:not(.tile-hero) > .specimen,
  .same {
    margin-top: auto;
  }

  .passkey {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
  }

  :global(.reveal-ready) .open-cover:not(.is-in) .wire {
    scale: 0;
  }
  @media print, (prefers-reduced-motion: reduce) {
    .wire {
      transition: none;
    }
    :global(.reveal-ready) .open-cover:not(.is-in) .wire {
      scale: 1;
    }
  }
</style>
