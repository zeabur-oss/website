---
import Icon from "../components/Icon.astro"
import Site from "../layouts/Site.astro"
import { blogUrl, type SiteLocale } from "../lib/urls.ts"
import { dateFormat, postSlug, postsFor, postUrl } from "./blog.ts"
import { blogCopy } from "./copy.ts"
import HeadingText from "./HeadingText.astro"

interface Props {
  locale: SiteLocale
}
const { locale } = Astro.props
const t = blogCopy[locale]
const posts = await postsFor(locale)
const date = dateFormat(locale, "medium")
---

<Site
  locale={locale}
  title={`${t.title} · Zeabur Open Source`}
  description={t.description}
  section="blog"
  image={`/og/blog/${locale}/index.png`}
  schema={{ "@type": "Blog", name: `${t.title} · Zeabur Open Source`, description: t.description }}
>
  <section class="wrap hero blog-head">
    <div class="hero-text stagger">
      <h1 class="display">{t.title}</h1>
      <p class="lead">{t.description}</p>
      <a class="more" href={`${blogUrl(locale)}/rss.xml`}>
        <Icon name="rss" />
        {t.rss}
      </a>
    </div>
  </section>

  <section class="wrap section blog-list" aria-label={t.title}>
    {posts.length === 0 ? (
      <p class="lead blog-empty" data-reveal>
        {t.empty}
      </p>
    ) : (
      <ol class="posts">
        {posts.map((post, i) => (
          <li data-reveal style={`--i:${Math.min(i, 4)}`}>
            <a href={postUrl(post)} class="post-row" data-slug={postSlug(post.id)}>
              <time datetime={post.data.pubDate.toISOString()}>
                {date.format(post.data.pubDate)}
              </time>
              <span class="post-text">
                <span class="post-title">
                  <span>
                    <HeadingText text={post.data.title} locale={locale} />
                  </span>
                  {post.data.draft && <span class="pill">{t.draft}</span>}
                </span>
                <span class="body">{post.data.description}</span>
              </span>
              <Icon name="arrow-right" class="go" />
            </a>
          </li>
        ))}
      </ol>
    )}
  </section>
</Site>

<style>
  .blog-head {
    padding-bottom: 0;
  }
  .blog-head .more {
    margin-top: 0.25rem;
  }
  .blog-list::before {
    margin-top: var(--section-space);
  }
  .blog-empty {
    max-width: 36rem;
  }
  .posts {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .post-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.5rem;
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--site-line);
    color: inherit;
    text-decoration: none;
  }
  li:first-child .post-row {
    padding-top: 0;
  }
  @media (min-width: 1024px) {
    .post-row {
      grid-template-columns: 7.5rem minmax(0, 1fr) auto;
      column-gap: 2rem;
      align-items: baseline;
    }
  }
  time {
    font-family: var(--font-stack-mono);
    font-size: 0.8125rem;
    color: var(--site-faint);
  }
  .post-text {
    display: grid;
    gap: 0.5rem;
  }
  .post-title {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.625rem);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.015em;
  }
  :lang(zh) .post-title {
    letter-spacing: 0;
  }
  .post-row :global(.go) {
    display: none;
    width: 1.125rem;
    height: 1.125rem;
    color: var(--site-faint);
    transition:
      translate var(--transition-duration-fast) var(--ease-site),
      color var(--transition-duration-fast) var(--ease-site);
  }
  @media (min-width: 1024px) {
    .post-row :global(.go) {
      display: block;
    }
  }
  .post-row:hover .post-title {
    color: var(--site-accent);
  }
  .post-row:hover :global(.go) {
    translate: 3px 0;
    color: var(--site-text);
  }
</style>
