---
import { cn } from "cn"
import Icon from "../components/Icon.astro"
import Site from "../layouts/Site.astro"
import { blogUrl, type SiteLocale } from "../lib/urls.ts"
import { dateFormat, postSlug, postsFor, postUrl } from "./blog.ts"
import { blogCopy } from "./copy.ts"
import HeadingText from "./HeadingText.astro"

interface Props {
  locale: SiteLocale
}
const { locale } = Astro.props
const t = blogCopy[locale]
const posts = await postsFor(locale)
const date = dateFormat(locale, "medium")
---

<Site
  locale={locale}
  title={`${t.title} · Zeabur Open Source`}
  description={t.description}
  section="blog"
  image={`/og/blog/${locale}/index.png`}
  schema={{ "@type": "Blog", name: `${t.title} · Zeabur Open Source`, description: t.description }}
>
  <section class="wrap hero pb-0">
    <div class="stagger flex flex-col items-start gap-6">
      <h1 class="display max-w-[14em]">{t.title}</h1>
      <p class="lead max-w-xl">{t.description}</p>
      <a class="more mt-1" href={`${blogUrl(locale)}/rss.xml`}>
        <Icon name="rss" />
        {t.rss}
      </a>
    </div>
  </section>

  <section class="wrap section before:mt-(--section-space)" aria-label={t.title}>
    {posts.length === 0 ? (
      <p class="lead max-w-xl" data-reveal>
        {t.empty}
      </p>
    ) : (
      <ol>
        {posts.map((post, i) => (
          <li data-reveal style={`--i:${Math.min(i, 4)}`}>
            <a
              href={postUrl(post)}
              class={cn(
                "group grid grid-cols-[minmax(0,1fr)] gap-2 border-b border-site-line py-6 text-inherit no-underline lg:grid-cols-[7.5rem_minmax(0,1fr)_auto] lg:items-baseline lg:gap-x-8",
                i === 0 && "pt-0",
              )}
              data-slug={postSlug(post.id)}
            >
              <time class="type-mono text-site-faint" datetime={post.data.pubDate.toISOString()}>
                {date.format(post.data.pubDate)}
              </time>
              <span class="grid gap-2">
                <span class="flex flex-wrap items-center gap-x-3 gap-y-2 text-[clamp(1.25rem,1.1rem+0.6vw,1.625rem)] leading-[1.3] font-semibold tracking-[-0.015em] group-hover:text-site-accent zh:tracking-normal">
                  <span>
                    <HeadingText text={post.data.title} locale={locale} />
                  </span>
                  {post.data.draft && <span class="pill">{t.draft}</span>}
                </span>
                <span class="body">{post.data.description}</span>
              </span>
              <Icon
                name="arrow-right"
                class="hidden size-4.5 text-site-faint transition-[translate,color] duration-fast ease-(--ease-site) group-hover:translate-x-[3px] group-hover:text-site-text lg:block"
              />
            </a>
          </li>
        ))}
      </ol>
    )}
  </section>
</Site>
