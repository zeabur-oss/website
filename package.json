    "@astrojs/starlight": "0.42.6",
    "@fontsource/geist-sans": "5.3.0",
    "@fontsource/noto-sans-sc": "5.3.1",
    "@fontsource/noto-sans-tc": "5.3.1",
    "@mdx-js/mdx": "3.1.1",
    "@phosphor-icons/core": "2.1.1",
    "@resvg/resvg-js": "2.6.2",
